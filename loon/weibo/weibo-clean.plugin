#!name=Weibo Clean
#!desc=微博去开屏、时间线与评论区广告；极简发现页（仅留纯净热搜，去横幅与下方 feed 流）、清空视频页推荐流，以及极简「我的」页（去超话社区/更多功能/任务中心/钱包）。
#!category=Weibo
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/weibo.png
#!tag=Weibo

[Argument]
block_ads = switch,true,type=boolean,tag=去广告,desc=过滤微博开屏、推荐/关注时间线、正文详情、评论区软广、商业热搜及综合搜索广告。
clean_ui = switch,true,type=boolean,tag=极简界面,desc=发现页仅保留热搜（清空下方横幅与全部 feed 流）；清空视频页推荐流；「我的」页移除超话社区、更多功能、任务中心、红包签到、钱包、借钱与游戏卡片。

[Rule]
# 拒绝 QUIC，强制回落 TCP：HTTP/3 走 UDP 不经过 MITM，脚本看不到请求。
AND, ((DOMAIN-SUFFIX, weibo.cn), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, weibo.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, weibocdn.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, sinaimg.cn), (PROTOCOL, QUIC)), REJECT

# 拦截微博 HTTPDNS，防止绕过域名 MITM
DOMAIN, dns.weibo.cn, REJECT
IP-CIDR, 39.97.128.148/32, REJECT, no-resolve
IP-CIDR, 39.97.130.51/32, REJECT, no-resolve

# 微博广告 SDK、素材与日志域名（保留 sdkapp/wbapp/bootpreload.uve.weibo.com 交由脚本覆写开屏缓存）
DOMAIN, aln.uve.weibo.com, REJECT
DOMAIN, click.uve.weibo.com, REJECT
DOMAIN, datacollection.uve.weibo.com, REJECT
DOMAIN, fastimage.uve.weibo.com, REJECT
DOMAIN, adimg.uve.weibo.com, REJECT
DOMAIN, ad.weibo.com, REJECT
DOMAIN, adstrategy.biz.weibo.com, REJECT
DOMAIN, alitui.weibo.com, REJECT
DOMAIN, biz.weibo.com, REJECT
DOMAIN, tui.weibo.com, REJECT
DOMAIN, dp.im.weibo.cn, REJECT
DOMAIN, game.weibo.cn, REJECT
DOMAIN, game.weibo.com, REJECT
DOMAIN, gw5.push.mcp.weibo.cn, REJECT
DOMAIN, gw6.push.mcp.weibo.cn, REJECT
DOMAIN, logmix.sina.cn, REJECT
DOMAIN, pay.sc.weibo.com, REJECT
DOMAIN, promote.biz.weibo.cn, REJECT
DOMAIN, sdkclick.mobile.sina.cn, REJECT
DOMAIN, trends.mobile.sina.cn, REJECT
DOMAIN, u1.img.mobile.sina.cn, REJECT
DOMAIN, wax.weibo.com, REJECT
DOMAIN, zymo.mps.weibo.com, REJECT
DOMAIN, adpinpai.video.weibocdn.com, REJECT

[Rewrite]
# 删除 If-None-Match / If-Modified-Since，防止「我的」页、发现页与视频页返回 304 导致继续使用本地缓存
request if ${url} ~= /^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:profile\/|users\/|search\/|searchall|flowpage|page|cardlist|container\/|video\/|statuses\/video_mixtimeline)/ then request.header.del("if-none-match")
request if ${url} ~= /^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:profile\/|users\/|search\/|searchall|flowpage|page|cardlist|container\/|video\/|statuses\/video_mixtimeline)/ then request.header.del("if-modified-since")

# 拦截微博 HTTPDNS 配置下发
request if ${url} ~= /^https?:\/\/[^/]*weibo\.c(?:n|om)\/(?:2\/)?httpdns\/config/ then reject(404)

# 实时开屏、SDK 配置、签到弹窗、日志、视频红点与发现页推广接口直接拦截
request if ${url} ~= /^https?:\/\/bootrealtime\.uve\.weibo\.com\/v\d+\/ad\/realtime/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info|sdkconfig)\.php/ then reject(404)
request if ${url} ~= /^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:ug\/checkin\/list|push\/daily|push\/info|logservice\/service|statuses\/unread_hot_timeline_ad|statuses\/container_positive|statuses\/push_info|comments\/bullet_screens|video\/(?:redpacket|remind_info)|hot\/hours_spotlight|search\/container_discover|profile\/recommend_popuser|!\/live\/media_homelist|!\/chaohua\/discovery\/home_bottom\/switch|!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)|!\/was\/finder\/searchbarchange|!\/wbox\/\w+\/(?:home_bottom_modal|interest_category)|(?:ad|sdk|preload|floater|pullad)\/)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.weibo\.cn\/!\/sug\/list\/finderchange\b/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:card\.weibo\.com\/article\/m\/aj|weibo\.com\/ttarticle\/x\/m\/aj)\/(?:reward|uvead)\b/ then reject_dict(200)

[Script]
# 开屏广告（覆写投放时间至 2040/2090 年，覆盖客户端本地开屏缓存）
response if ${url} ~= /^https?:\/\/(?:(?:sdk|wb)app|bootpreload)\.uve\.weibo\.com\/(?:interface\/sdk\/sdkad\.php|wbapplua\/wbpullad\.lua|preload\/get_ad|v\d+\/ad\/preload)/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/weibo/js/weibo_clean.js?v=20261124-2", {${block_ads}, ${clean_ui}}) with requires_body=true, tag="Weibo Clean Splash", timeout=20
# 主体接口（时间线、视频页、评论、发现纯热搜、综合搜索与极简我的页）
response if ${url} ~= /^https?:\/\/(?:[\w-]+\.)?(?:api|m|mapi)\.weibo\.c(?:n|om)\/2\/(?:push\/active|client\/|checkin\/show|ug\/checkin\/stream|statuses\/|groups\/(?:timeline|allgroups\/v2)|video\/|comments\/(?:build_comments|mix_comments)|search\/|searchall|flowpage|flowlist|container\/|page|cardlist|profile\/|users\/show|direct_messages\/user_list|messageflow\/notice|!\/huati\/discovery_home_bottom_channels)/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/weibo/js/weibo_clean.js?v=20261124-2", {${block_ads}, ${clean_ui}}) with requires_body=true, tag="Weibo Clean", timeout=20

[MitM]
hostname = *.weibo.cn, *.api.weibo.cn, *.uve.weibo.com, *.weibo.com, weibo.com
h2 = true
