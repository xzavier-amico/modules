#!name = 📺 BiliBili: Biliverse (Enhanced+Global+Redirect+ADBlock)
#!desc = 哔哩哔哩：增强 + 全球 + 重定向 + 去广告 合并模块
#!author = VirgilClyne et al.
#!homepage = https://biliverse.github.io/guide/
#!icon = https://github.com/Biliverse/Enhanced/raw/main/src/assets/icon_rounded.png
#!tag = BiliBili,Biliverse

[Argument]
Home.Switch = switch,true,type=boolean,tag=[首页] 启用自定义功能,desc=启用后可自定义首页顶栏、标签页和底部导航栏内容。标签页由分区页的快捷访问决定。
Home.Tab = input,"2036,2037,780,545,151",type=string,tag=[首页] 标签页,desc=这里只列出常用选项；分区页提供接近60个快捷访问选项，无法在模块参数中完整列出。请前往 BiliBili App 分区页，使用原生“快捷访问”功能自定义首页标签页。
Home.Tab_default = select,"2037","2036","780","545","774","151","801","2280",type=string,tag=[首页] 默认标签页,desc=请选择启动APP时默认展示的标签页，需先将该标签页加入分区页的快捷访问。
Home.Top_left = select,"mine","videoshortcut",type=string,tag=[首页] 顶栏（左侧）按钮（用户头像）,desc=请选择顶栏（左侧）按钮（用户头像）的作用（在biliBili粉色版中无法修改）。
Home.Top = input,"messages",type=string,tag=[首页] 顶栏（右侧）按钮,desc=请选择启用的顶栏（右侧）按钮。
Home.Top_more = input,"categories,search",type=string,tag=[首页] 标签栏右侧按钮,desc=请选择启用的首页标签栏右侧按钮。
Bottom = input,"home,dynamic,ogv,mall,mine",type=string,tag=[底部] 导航栏按钮,desc=请选择启用的底部导航栏按钮，最多6个。
Region.Switch = switch,true,type=boolean,tag=[分区] 启用此标签页自定义功能,desc=启用后可自定义分区标签页的内容。
Mine.Switch = switch,true,type=boolean,tag=[我的] 启用此标签页自定义功能,desc=启用后可自定义我的标签页的服务内容。
Mine.iPad.Switch = switch,true,type=boolean,tag=[我的 iPad版] 启用此标签页自定义功能,desc=启用后可自定义iPad版我的标签页的服务内容。
Storage = select,"PersistentStore","Argument","database",type=string,tag=[储存] 配置类型,desc=默认使用 PersistentStore，配置优先级为 database -> $argument -> PersistentStore (BoxJs)；选择 Argument 时为 database -> PersistentStore (BoxJs) -> $argument。
LogLevel = select,"WARN","OFF","ERROR","INFO","DEBUG","ALL",type=string,tag=[调试] 日志等级,desc=选择脚本日志的输出等级，低于所选等级的日志将全部输出。
ForceHost = select,"1","0","2",type=string,tag=强制CDN主机名类型,desc=请设置强制返回的CDN主机名类型。
Locales = input,"CHN,HKG,TWN",type=string,tag=启用自动识别与分流功能的地区,desc=请选择启用自动识别与分流功能的地区。
Proxies.CHN = input,"DIRECT",type=string,tag=[🇨🇳中国大陆] 代理策略名称,desc=请填写此地区的代理或策略组名称。
Proxies.HKG = input,"🇭🇰香港",type=string,tag=[🇭🇰中国香港] 代理策略名称,desc=请填写此地区的代理或策略组名称。
Proxies.MAC = input,"🇲🇴澳门",type=string,tag=[🇲🇴中国澳门] 代理策略名称,desc=请填写此地区的代理或策略组名称。
Proxies.TWN = input,"🇹🇼台湾",type=string,tag=[🇹🇼中国台湾] 代理策略名称,desc=请填写此地区的代理或策略组名称。
Host.OverseaVideo = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirrorhwov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com",type=string,tag=[主机名] 重定向 OverseaVideo CDN (港澳台),desc=请选择 OverseaVideo 要重定向的主机名。
Host.BStar = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirrorhwov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com",type=string,tag=[主机名] 重定向 BStar CDN (国际版),desc=请选择 BStar 要重定向的主机名。
Host.PCDN = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com","upos-sz-mirroraliov.bilivideo.com","upos-sz-mirrorcosov.bilivideo.com","upos-sz-mirrorhwov.bilivideo.com","cn-hk-eq-01-01.bilivideo.com","cn-hk-eq-01-03.bilivideo.com","cn-hk-eq-01-09.bilivideo.com","cn-hk-eq-01-10.bilivideo.com","cn-hk-eq-01-12.bilivideo.com","cn-hk-eq-01-13.bilivideo.com","cn-hk-eq-01-14.bilivideo.com",type=string,tag=[主机名] 重定向 PCDN 主机名 (中国大陆),desc=请选择 PCDN 要重定向的主机名。
Host.MCDN = select,"proxy-tf-all-ws.bilivideo.com",type=string,tag=[主机名] 重定向 MCDN 主机名 (中国大陆),desc=请选择 MCDN 要重定向的主机名。
Splash = switch,true,type=boolean,tag=[开屏] 去除广告,desc=是否启用此处修改
Feed.AD = switch,true,type=boolean,tag=[推荐] 去除广告,desc=是否启用此处修改
Feed.Activity = switch,false,type=boolean,tag=[推荐] 去除“活动大图”,desc=是否启用此处修改
Feed.Vertical = switch,false,type=boolean,tag=[推荐] 去除竖屏视频,desc=是否启用此处修改
Feed.BlockUpLiveList = input,"",type=string,tag=[推荐] 屏蔽UP主直播推广,desc=填写up主uid，以英文逗号隔开。
Feed.Story = switch,true,type=boolean,tag=[首页] 去除短视频流广告,desc=是否启用此处修改
Feed.StoryCommercial = switch,true,type=boolean,tag=[首页] 去除Story商业按钮,desc=移除Story中的“助TA必火”等商业推广按钮，不删除视频卡片。
Search.AD = switch,true,type=boolean,tag=[搜索] 去除广告,desc=是否启用此处修改
Search.Tracking = switch,false,type=boolean,tag=[搜索] 移除响应跟踪参数,desc=清理SearchAll结果对象及跳转链接中的trackid、report_flow_data，不修改播放签名和预加载数据。
Search.HotSearch = switch,true,type=boolean,tag=[搜索] 去除“热搜”,desc=是否启用此处修改
PGC.AD = switch,true,type=boolean,tag=[番剧电影] 去除广告,desc=是否启用此处修改
Xlive.AD = switch,true,type=boolean,tag=[直播] 去除广告,desc=是否启用此处修改
Xlive.RemoveTrackingCallbacks = switch,false,type=boolean,tag=[直播] 移除推荐回调,desc=移除直播推荐卡的show_callback与click_callback；可能影响推荐状态和翻页。
Xlive.RemovePreloadTracking = switch,false,type=boolean,tag=[直播] 移除预载链接trackid,desc=只移除直播small_card_v1.subtitle_style.link中的trackid，保留播放、清晰度和会话参数。
Dynamic.HotTopics = switch,true,type=boolean,tag=[动态] 去除“热门话题”,desc=是否启用此处修改
Dynamic.MostVisited = switch,false,type=boolean,tag=[动态] 去除“最常访问”,desc=是否启用此处修改
Dynamic.MostVisitedLiveOnly = switch,false,type=boolean,tag=[动态] “最常访问”仅显示直播,desc=是否启用此处修改
Dynamic.AdCard = switch,true,type=boolean,tag=[动态] 去除广告卡片,desc=是否启用此处修改
Dynamic.PersonalAdCard = switch,false,type=boolean,tag=[动态] 去除个人流广告卡片,desc=过滤DynAllPersonal与DynVideoPersonal中的cardType=15；当前抓包尚无广告阳性样本。
View.AD = switch,true,type=boolean,tag=[视频] 去除播放页广告,desc=是否启用此处修改
DM.Command = switch,false,type=boolean,tag=[弹幕] 去除交互式弹幕,desc=是否启用此处修改
DM.Colorful = switch,false,type=boolean,tag=[弹幕] 替换彩色弹幕,desc=是否启用此处修改
DM.Airborne = switch,false,type=boolean,tag=[弹幕] 空降助手,desc=是否启用此处修改
Reply.AD = switch,true,type=boolean,tag=[评论] 去除广告,desc=是否启用此处修改
Reply.CommercialLinks = switch,false,type=boolean,tag=[评论] 禁用普通评论商业跳转,desc=保留普通评论正文与回复树，仅移除已识别商品链接的可点击映射。
Reply.SubjectDescriptionCommercial = switch,false,type=boolean,tag=[评论] 隐藏编辑器商品能力,desc=移除SubjectDescription中的商品与商业助手按钮(type 5/8)；当前抓包中它们均为隐藏状态。
Privacy.Tracking = switch,true,type=boolean,tag=[隐私] 移除响应链接跟踪参数,desc=清理推荐、Story 与评论跳转链接中的高置信度归因参数，保留目标和界面功能参数。
Privacy.BlockBiliCommercial = switch,false,type=boolean,tag=[隐私] 阻止B站商业上报,desc=本地成功响应conversion/mobile/v2与fees/wise，阻止相关请求上传。
Privacy.BlockThirdParty = switch,false,type=boolean,tag=[隐私] 阻止第三方广告归因,desc=本地响应已确认的千问与Solar Engine广告展示、点击和归因请求。
Privacy.Strict = switch,false,type=boolean,tag=[隐私] 严格模式,desc=同时启用响应跟踪清理、商业链接与上报阻断，并移除直播show/click callback；可能影响跳转、推荐和翻页。

[General]
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *:4480, *:4483, *:8000, *:8082, *:9102

[Rewrite]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/theme\.css(?:\?[^#]*)?$/i then response.body.mock_file("css", "https://biliverse.github.io/settings/theme.css", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/home\.json(?:\?[^#]*)?$/i then response.body.mock_file("json", "https://biliverse.github.io/settings/home.json", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/(?:\?[^#]*)?$/i then response.body.mock_file("html", "https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/home.html", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/settings\/bridge\.mjs(?:\?[^#]*)?$/i then response.body.mock_file("javascript", "https://biliverse.github.io/settings/bridge.mjs", 200) | response.header.add("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Enhanced(?:\?.*)?$/i then response.body.mock_file("json", "https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/Biliverse.Enhanced.PreferencePanes.json", 200) | response.header.add(["X-PreferencePanes-Version", "Cache-Control"], ["0.6.2", "no-store"])
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Global(?:\?.*)?$/ then response.body.mock_file("json", "https://github.com/Biliverse/Global/releases/download/v0.9.3/BiliBili.Global.boxjs.json", 200) | response.header.set("X-PreferencePanes-Version", "0.9.3") | response.header.set("Cache-Control", "no-store")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Redirect(?:\?.*)?$/ then response.body.mock_file("json", "https://github.com/Biliverse/Redirect/releases/download/v0.2.25/BiliBili.Redirect.boxjs.json", 200) | response.header.set("X-PreferencePanes-Version", "0.2.25") | response.header.set("Cache-Control", "no-store")
response if ${url} ~= /^https?:\/\/(grpc\.biliapi\.net|app\.biliapi\.net|app\.bilibili\.com|app\.biliapi\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/ then response.body.mock("text", "AAAAAAA=", 200, true) | response.header.set("Content-Type", "application/grpc") | response.header.set("grpc-status", "0")
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/ADBlock(?:\?.*)?$/ then response.body.mock_file("json", "https://github.com/Biliverse/ADBlock/releases/download/v0.7.5/BiliBili.ADBlock.boxjs.json", 200) | response.header.set("X-PreferencePanes-Version", "0.7.5") | response.header.set("Cache-Control", "no-store")
# 去除搜索中的大家都在搜
request if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words/ then reject_dict(200)
# 去除动态中的话题
request if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr/ then reject_dict(200)
# 去除动态中的最常访问
request if ${url} ~= /^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist/ then reject_dict(200)
# BiliBili漫画去广告
request if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash/ then reject_dict(200)
request if ${url} ~= /^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\?/ then reject_dict(200)
# 番剧页可能弹出的HTML广告
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?/ then response.body.mock("text", `{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}`, 200)
# iPad端番剧推荐列表上方广告
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\?/ then response.json.jq("del(.data.payment)")

[Script]
request if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/(?:get|set|delete)(?:\?.*)?$/ then script("https://github.com/NSNanoCat/PreferencePanes/releases/latest/download/api.js") with tag="PreferencePanes.API", requires_body=true, timeout=30
response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/resource\/show\/tab\/v2\?/ then script("https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.resource.show.tab.v2", requires_body=true, timeout=30
request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionShortcut$/ then script("https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/request.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.show.v1.Mixture.RegionShortcut.request.grpc", requires_body=true, binary_body_mode=true, timeout=30
response if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.show\.v1\.Mixture\/RegionList$/ then script("https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.show.v1.Mixture.RegionList.response.grpc", requires_body=true, binary_body_mode=true, timeout=30
response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/account\/mine(\/ipad)?\?/ then script("https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.v2.account.mine", requires_body=true, timeout=30
response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/region\/index\?/ then script("https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.v2.region.index", requires_body=true, timeout=30
response if ${url} ~= /^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/channel\/region\/list\?/ then script("https://github.com/Biliverse/Enhanced/releases/download/v0.6.2/response.bundle.js", {${Home.Switch}, ${Home.Tab}, ${Home.Tab_default}, ${Home.Top_left}, ${Home.Top}, ${Home.Top_more}, ${Bottom}, ${Region.Switch}, ${Mine.Switch}, ${Mine.iPad.Switch}, ${Storage}, ${LogLevel}}) with tag="📺 Biliverse.Enhanced.x.v2.channel.region.list", requires_body=true, timeout=30
request if ${url} ~= /^https?:\/\/www\.bilibili\.com\/bangumi\/play\/(ss|ep)\d+\/?/ then script("https://github.com/Biliverse/Global/releases/download/v0.9.3/request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.bangumi.play.html", requires_body=true, timeout=30
request if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$/ then script("https://github.com/Biliverse/Global/releases/download/v0.9.3/request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.viewunite.v1.View.grpc", requires_body=true, binary_body_mode=true, timeout=30
response if ${url} ~= /^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.viewunite\.v1\.View\/View$/ then script("https://github.com/Biliverse/Global/releases/download/v0.9.3/response.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.viewunite.v1.View.grpc", requires_body=true, binary_body_mode=true, timeout=30
request if ${url} ~= /^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/view\/(v2\/app|web|pc)\/season\?/ then script("https://github.com/Biliverse/Global/releases/download/v0.9.3/request.bundle.js", {${ForceHost}, ${Locales}, ${Proxies.CHN}, ${Proxies.HKG}, ${Proxies.MAC}, ${Proxies.TWN}, ${Storage}, ${LogLevel}}) with tag="📺 BiliBili.Global.season.json", timeout=30
