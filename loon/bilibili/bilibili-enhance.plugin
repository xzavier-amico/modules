hostname = biliverse.github.io, app.bilibili.com, app.biliapi.net, grpc.biliapi.net, www.bilibili.com, search.bilibili.com, api.bilibili.com, api.global.bilibili.com, api.biliapi.net, manga.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, app.biliapi.com, cm.bilibili.com, adtrack.qianwen.com, tkio-redirect.solar-engine.com
h2 = true