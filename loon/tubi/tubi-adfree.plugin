#!name=Tubi Ad-Free
#!desc=去广告：广告决策接口返回空广告列表，VAST / VMAP 换成空文档。不改动视频流，不触发 Tubi 的广告拦截检测。
#!category=Tubi
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Tubi.png
#!tag=Tubi

[Argument]
block_ads = switch,true,type=boolean,tag=去除广告,desc=把广告决策接口的 ads 列表清空，并把 VAST / VMAP 换成空文档。

[Rule]
# Tubi 只在美国可用。这里把它的域名固定走代理，避免被「国内直连」类规则带走，
# 导致 MITM 看不到流量、模块静默失效。
# 如果你本身在美国，或想指定某个策略组/节点，把下面六行的 PROXY 改成 DIRECT
# 或你的策略组名称即可。
DOMAIN-SUFFIX,tubitv.com,PROXY
DOMAIN-SUFFIX,tubi.com,PROXY
DOMAIN-SUFFIX,tubi.tv,PROXY
DOMAIN-SUFFIX,tubi.video,PROXY
DOMAIN-SUFFIX,tubi.io,PROXY
DOMAIN-SUFFIX,adrise.tv,PROXY

[Script]
response if ${url} ~= /^https?:\/\/(?:rainmaker\d*\.production-public\.tubi\.io|ads\.adrise\.tv|ads\.tubi\.io|ads\.production-public\.tubi\.io)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/tubi/js/tubi_adfree.js", {${block_ads}}) with requires_body=true, tag="Tubi Ad-Free", timeout=10

[MitM]
hostname = rainmaker.production-public.tubi.io, rainmaker4.production-public.tubi.io, ads.tubi.io, ads.adrise.tv, ads.production-public.tubi.io
