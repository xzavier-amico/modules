#!name=Spotify Enhance
#!desc=去广告、解锁 Premium 播放限制，并用第三方歌词补全 Now Playing 与歌词卡；iPhone / iPad 与 Loon for Mac 共用。
#!category=Spotify
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/spotify.png
#!tag=Spotify

[Argument]
spoof_premium = switch,true,type=boolean,tag=伪装 Premium,desc=把账号状态改写为 premium；关闭后不影响歌词补全。
block_ads = switch,true,type=boolean,tag=去除广告,desc=关闭广告开关并移除广告与推广位配置。
unlock_playback = select,auto,true,false,type=string,tag=解锁播放限制,desc=auto 移动端开启、桌面端关闭；强制 true / false 覆盖。桌面端写播放授权容易跳歌。
enable_lyrics = switch,true,type=boolean,tag=补全歌词,desc=官方没有歌词时用第三方歌词补全；关闭后停止补全。
lyrics_source = select,auto,lrclib,musixmatch,netease,qq,type=string,tag=歌词来源,desc=官方没有歌词时使用的歌词源。auto 并发查询网易云、QQ、LRCLIB、Musixmatch，首个匹配的同步歌词胜出；Musixmatch（Spotify 官方上游）排最后，前三个都落空时才用它兜底。
desktop = select,auto,ios,macos,type=string,tag=设备类型,desc=auto 按 User-Agent 识别 iPhone / iPad 与 Loon for Mac；识别不准时手动指定。
lyrics_script = select,hans,source,type=string,tag=歌词字形,desc=hans 把官方与第三方歌词都转成简体（默认），source 保持原文；官方歌词会按 language 判断并同步改成 zh-Hans。
meta_script = select,source,hans,type=string,tag=界面字形,desc=hans 把曲名 / 歌手 / 专辑名里的繁体字转成简体；source 保持 Spotify 原文（默认）。含日文假名的名称保持原样。
ignore_han_variants = switch,true,type=boolean,tag=忽略简繁,desc=查歌词时把繁体曲名 / 歌手按简体比较，兼容 Spotify 的繁体元数据与简体曲库；关闭后繁简写法必须完全一致。
sync_plain_lyrics = switch,true,type=boolean,tag=纯文本伪同步,desc=官方和曲库都只有纯文本歌词时，按歌曲时长把每行均分出时间轴，让它能跟着滚动；关掉则只按纯文本整齐显示（不滚动）。
lyrics_isrc = switch,true,type=boolean,tag=ISRC 反查,desc=前几轮都没搜到时，用 Deezer 公开接口反查这首歌的 ISRC，再用 ISRC 直查 Musixmatch、并用 Deezer 的规范曲名重查一遍曲库；关掉可少两次请求。
prefetch_lyrics = switch,true,type=boolean,tag=预取下一首,desc=打开 Now Playing 时顺手把队列里下一首的歌词查好写进缓存，切歌后歌词卡 / 歌词页直接命中；不阻塞卡片渲染。

[Rule]
# 广告域名兜底：脚本关闭服务端广告开关，这里拦截广告素材与曝光回传。
# 音频广告由服务端插入音频流，域名层无法拦截。
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
# 歌词源直连：网易云 / QQ 音乐在国内，走代理反而多绕一圈。
DOMAIN,music.163.com,DIRECT
DOMAIN,c.y.qq.com,DIRECT
# 强制 Spotify 的 QUIC 回落到 TCP，确保请求经过 HTTP 代理。
# 个别版本拒绝 QUIC 后可能跳歌；通用插件按 User-Agent 识别 Loon for Mac。
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT

[Rewrite]
# 删除 if-none-match 与 if-modified-since，避免 304 空响应导致脚本拿不到 body。
request if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|extended-metadata|context-resolve|connect-state|metadata\/4\/(?:track|album|artist|show|episode)|color-lyrics|remote-config-resolver|nebula|casita|browsita|scrollsita|playlist\/v2|collection\/v2|searchview|search\/v[23]|album\/v2|artist\/v2|track-entity-view|creatorabout\/v0|vanilla\/v1|user-profile-view|genre-view|browse\/v2)\//i then request.header.del("if-none-match")
request if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|extended-metadata|context-resolve|connect-state|metadata\/4\/(?:track|album|artist|show|episode)|color-lyrics|remote-config-resolver|nebula|casita|browsita|scrollsita|playlist\/v2|collection\/v2|searchview|search\/v[23]|album\/v2|artist\/v2|track-entity-view|creatorabout\/v0|vanilla\/v1|user-profile-view|genre-view|browse\/v2)\//i then request.header.del("if-modified-since")
# 桌面端广告与推广接口；iOS 不请求这些路径，保留不影响。
request if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?(?:\/ads\/|\/ad-|\/premium-marketing\/|[^?#]*\/ad-on-app-open)/i then reject(404)

[Script]
# 请求头 / 时区：按账号地区改写 URL 里的 timezone（固定开启）。
request if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/.*[?&]timezone=/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.headers.js?v=20261126-3") with tag="spotify.headers", timeout=5
# pathfinder 响应可能是 zstd，改成 identity 保证名称脚本能读到明文 JSON。
request if ${url} ~= /^https:\/\/api-partner\.spotify\.com\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.headers.js?v=20261126-3") with tag="spotify.partner.headers", timeout=5
# 删除 extended-metadata 请求体里的 etag，避免服务端回空数组。
request if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/extended-metadata\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261126-3", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${prefetch_lyrics}, ${sync_plain_lyrics}, ${lyrics_isrc}, ${meta_script}}) with requires_body=true, binary_body_mode=true, tag="spotify.meta.req", timeout=10
# 改写账号状态与远程配置。不要加 enable=${spoof_premium}：只开「去除广告」时脚本也要运行。
response if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261126-3", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${prefetch_lyrics}, ${sync_plain_lyrics}, ${lyrics_isrc}, ${meta_script}}) with requires_body=true, binary_body_mode=true, tag="Spotify Enhance", timeout=30
# 将曲目元数据里的 has_lyrics 改为 true，客户端才会请求 color-lyrics；开启界面字形时同时把曲名 / 歌手 / 专辑名转成简体。
response if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261126-3", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${prefetch_lyrics}, ${sync_plain_lyrics}, ${lyrics_isrc}, ${meta_script}}) with requires_body=true, binary_body_mode=true, tag="spotify.meta", timeout=10
# 改写 bootstrap 之后重新拉取的远程配置与账号属性。
response if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:remote-config-resolver|nebula)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261126-3", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${prefetch_lyrics}, ${sync_plain_lyrics}, ${lyrics_isrc}, ${meta_script}}) with requires_body=true, binary_body_mode=true, tag="spotify.config", timeout=10
# 过滤首页 / 搜索 / 滚动页赞助内容，并补歌词 section。
response if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:casita\/v\d+\/home|browsita\/v\d+\/browse|scrollsita\/v\d+\/scroll)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.feed.js?v=20261126-3", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${prefetch_lyrics}, ${sync_plain_lyrics}, ${lyrics_isrc}, ${meta_script}, ${lyrics_script}, ${ignore_han_variants}}) with requires_body=true, binary_body_mode=true, tag="spotify.feed", timeout=30
# Pathfinder（歌单 / 专辑 / 歌手 / 搜索 / 资料库）是 JSON，单独转名称。
response if ${url} ~= /^https:\/\/api-partner\.spotify\.com\/pathfinder\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.partner.js?v=20261126-3", {${meta_script}}) with requires_body=true, tag="spotify.partner", timeout=10
# spclient 的列表 / 实体接口（playlist、collection、searchview、album、artist、metadata/4/album|artist 等）是 protobuf。
response if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:playlist\/v2|collection\/v2|searchview|search\/v[23]|album\/v2|artist\/v2|track-entity-view|metadata\/4\/(?:album|artist|show|episode)|creatorabout\/v0|vanilla\/v1|user-profile-view|genre-view|browse\/v2)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.partner.js?v=20261126-3", {${meta_script}}) with requires_body=true, binary_body_mode=true, tag="spotify.names", timeout=10
# 官方有歌词时按 lyrics_script 转简体（默认），没有时用第三方歌词补全。
# 不启用 requires_body：官方 404 时没有 body，脚本仍需执行。
response if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js?v=20261126-3", {${lyrics_source}, ${enable_lyrics}, ${desktop}, ${lyrics_script}, ${ignore_han_variants}, ${sync_plain_lyrics}, ${lyrics_isrc}}) with enable=${enable_lyrics}, binary_body_mode=true, tag="spotify.lyrics", timeout=30
# 请求阶段：缓存命中直接返回；未命中时并行请求官方与 auto 歌词源。
request if ${url} ~= /^https:\/\/(?:[\w-]+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js?v=20261126-3", {${lyrics_source}, ${enable_lyrics}, ${desktop}, ${lyrics_script}, ${ignore_han_variants}, ${sync_plain_lyrics}, ${lyrics_isrc}}) with enable=${enable_lyrics}, binary_body_mode=true, tag="spotify.lyrics.req", timeout=30

[MitM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com, api-partner.spotify.com
h2 = true
