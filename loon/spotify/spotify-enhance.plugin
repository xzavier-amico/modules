#!name=Spotify Enhance
#!desc=去广告、解锁 Premium 播放限制，并用第三方歌词补全 Now Playing 与歌词卡；iPhone / iPad 与 Loon for Mac 共用。
#!category=Spotify
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/spotify.png
#!tag=Spotify

[Argument]
spoof_premium = switch,true,type=boolean,tag=伪装 Premium,desc=把账号状态改写为 premium；关闭后不影响歌词补全。
block_ads = switch,true,type=boolean,tag=去除广告,desc=关闭广告开关并移除广告与推广位配置。
unlock_playback = select,auto,true,false,type=string,tag=解锁播放限制,desc=auto 移动端开启、桌面端关闭；强制 true / false 覆盖。桌面端写播放授权容易跳歌。
enable_lyrics = switch,true,type=boolean,tag=补全歌词,desc=官方没有歌词时用第三方歌词补全；关闭后停止补全。
lyrics_source = select,auto,lrclib,musixmatch,netease,qq,type=string,tag=歌词来源,desc=官方没有歌词时使用的歌词源。auto 并发查询网易云、QQ、LRCLIB，首个匹配的同步歌词胜出；Musixmatch 仅在显式选择时使用。
desktop = select,auto,ios,macos,type=string,tag=设备类型,desc=auto 按 User-Agent 识别 iPhone / iPad 与 Loon for Mac；识别不准时手动指定。
debug_log = switch,false,type=boolean,tag=排障日志,desc=输出歌词卡、元数据缓存的时序日志（含曲名），排查完请关闭。

[Rule]
# 广告域名兜底：脚本关闭服务端广告开关，这里拦截广告素材与曝光回传。
# 音频广告由服务端插入音频流，域名层无法拦截。
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
# 歌词源直连：网易云 / QQ 音乐在国内，走代理反而多绕一圈。
DOMAIN,music.163.com,DIRECT
DOMAIN,c.y.qq.com,DIRECT
# 强制 Spotify 的 QUIC 回落到 TCP，确保请求经过 HTTP 代理。
# 个别版本拒绝 QUIC 后可能跳歌；Loon for Mac 遇到时改用 spotify-enhance-mac.plugin。
AND, ((DOMAIN-SUFFIX, spotify.com), (PROTOCOL, QUIC)), REJECT

[Rewrite]
# 删除 if-none-match，避免 304 空响应导致脚本拿不到 body。
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|extended-metadata|color-lyrics|remote-config-resolver|nebula|casita|browsita|scrollsita)\//i then request.header.del("if-none-match")
# 桌面端广告接口；iOS 不请求这些路径，保留不影响。
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/ads\/v[12]\//i then reject(404)

[Script]
# 删除 extended-metadata 请求体里的 etag，避免服务端回空数组。
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/extended-metadata\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-20", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${debug_log}}) with enable=${enable_lyrics}, requires_body=true, binary_body_mode=true, tag="spotify.meta.req", timeout=10
# 改写账号状态与远程配置。不要加 enable=${spoof_premium}：只开「去除广告」时脚本也要运行。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-20", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${debug_log}}) with requires_body=true, binary_body_mode=true, tag="Spotify Enhance", timeout=30
# 将曲目元数据里的 has_lyrics 改为 true，客户端才会请求 color-lyrics。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-20", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${debug_log}}) with enable=${enable_lyrics}, requires_body=true, binary_body_mode=true, tag="spotify.meta", timeout=10
# 改写 bootstrap 之后重新拉取的远程配置与账号属性。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:remote-config-resolver|nebula)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-20", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${debug_log}}) with requires_body=true, binary_body_mode=true, tag="spotify.config", timeout=10
# 过滤首页 / 搜索 / 滚动页赞助内容，并补歌词 section。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:casita\/v\d+\/home|browsita\/v\d+\/browse|scrollsita\/v\d+\/scroll)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.feed.js?v=20261114-23", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}, ${debug_log}}) with requires_body=true, binary_body_mode=true, tag="spotify.feed", timeout=30
# 官方有歌词时原样放行，没有时用第三方歌词补全。
# 不启用 requires_body：官方 404 时没有 body，脚本仍需执行。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js?v=20261114-23", {${lyrics_source}, ${enable_lyrics}, ${desktop}, ${debug_log}}) with enable=${enable_lyrics}, binary_body_mode=true, tag="spotify.lyrics", timeout=30
# 请求阶段：缓存里已有第三方歌词时直接返回，跳过可能很慢的官方歌词请求。
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js?v=20261114-23", {${lyrics_source}, ${enable_lyrics}, ${desktop}, ${debug_log}}) with enable=${enable_lyrics}, binary_body_mode=true, tag="spotify.lyrics.req", timeout=10

[MitM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com
