#!name=Spotify Enhance (macOS)
#!desc=macOS 兼容入口：去广告、Premium 展示与第三方歌词；默认不写播放授权。
#!category=Spotify
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/spotify.png
#!tag=Spotify

# 通用插件 spotify-enhance.plugin 已支持按 User-Agent 自动识别 Loon for Mac，
# 新装用户优先用通用插件。本文件保留给已经安装的 macOS 用户：
#   1. 固定桌面模式，不写播放授权；
#   2. QUIC 回落默认关闭，避免部分版本播放几秒后跳歌。
# 安装后仍需开启 MitM 并在钥匙串里信任 Loon 证书，然后完全退出并重新打开 Spotify。

[Argument]
spoof_premium = switch,true,type=boolean,tag=伪装 Premium,desc=把账号展示状态改写为 premium；桌面版只写展示属性，不写播放授权。
block_ads = switch,true,type=boolean,tag=去除广告,desc=关闭广告属性，并拦截广告域名与桌面端广告接口。
unlock_playback = switch,false,type=boolean,tag=尝试解锁播放授权,desc=写入 player-license、streaming-rules 等播放授权字段；桌面端可能跳歌，默认关闭。
enable_lyrics = switch,true,type=boolean,tag=补全歌词,desc=官方没有歌词时用第三方歌词补全。
lyrics_source = select,auto,lrclib,musixmatch,netease,qq,type=string,tag=歌词来源,desc=官方没有歌词时使用的歌词源。auto 并发查询网易云、QQ、LRCLIB，首个匹配的同步歌词胜出；Musixmatch 仅在显式选择时使用。
desktop = switch,true,type=boolean,tag=桌面模式,desc=内部开关，保持开启。

[Rule]
# 广告域名兜底：拦截桌面端广告素材与曝光回传。
# 音频广告由服务端插入音频流，域名层无法拦截。
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
# 歌词源直连：网易云 / QQ 音乐在国内，走代理反而多绕一圈。
DOMAIN,music.163.com,DIRECT
DOMAIN,c.y.qq.com,DIRECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

# 如果始终没有 spotify.mac 脚本执行记录，取消下面这行注释，
# 强制 Spotify 的 QUIC 回落到 TCP 后重启 App。
# 部分版本拒绝 QUIC 后可能跳歌，遇到时再调整。
# AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT

[Rewrite]
# 删除 if-none-match，避免 304 空响应导致脚本拿不到 body。
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|extended-metadata|color-lyrics|remote-config-resolver|nebula|casita|browsita|scrollsita)\//i then request.header.del("if-none-match")

# 拦截桌面端广告接口。
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/ads\/v[12]\//i then reject(404)

[Script]
# 删除 extended-metadata 请求体里的 etag。
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/extended-metadata\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-15", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}}) with enable=${enable_lyrics}, requires_body=true, binary_body_mode=true, tag="spotify.mac.meta.req", timeout=10

# 改写账号状态与远程配置。关闭伪装 Premium 时仍需运行，以便单独去广告。
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-15", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}}) with requires_body=true, binary_body_mode=true, tag="spotify.mac", timeout=30

# 将曲目元数据里的 has_lyrics 改为 true，客户端才会请求 color-lyrics。
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-15", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}}) with enable=${enable_lyrics}, requires_body=true, binary_body_mode=true, tag="spotify.mac.meta", timeout=10

# 改写 bootstrap 之后重新拉取的远程配置与账号属性。
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:remote-config-resolver|nebula)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.js?v=20261114-15", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}}) with requires_body=true, binary_body_mode=true, tag="spotify.mac.config", timeout=10
# 过滤首页 / 搜索 / 滚动页赞助内容，并补歌词 section。
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:casita\/v\d+\/home|browsita\/v\d+\/browse|scrollsita\/v\d+\/scroll)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify.feed.js?v=20261114-19", {${spoof_premium}, ${block_ads}, ${unlock_playback}, ${enable_lyrics}, ${desktop}, ${lyrics_source}}) with requires_body=true, binary_body_mode=true, tag="spotify.mac.feed", timeout=30

# 官方有歌词时原样放行，没有时用第三方歌词补全。
# 不启用 requires_body：官方 404 时没有 body，脚本仍需执行。
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js?v=20261114-19", {${lyrics_source}, ${enable_lyrics}, ${desktop}}) with enable=${enable_lyrics}, binary_body_mode=true, tag="spotify.mac.lyrics", timeout=30
# 请求阶段：缓存里已有第三方歌词时直接返回，跳过可能很慢的官方歌词请求。
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js?v=20261114-19", {${lyrics_source}, ${enable_lyrics}, ${desktop}}) with enable=${enable_lyrics}, binary_body_mode=true, tag="spotify.mac.lyrics.req", timeout=10

[MitM]
# 桌面端与 iOS 共用 spclient 主机；若出现跳歌，可尝试排除 guc3。
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
