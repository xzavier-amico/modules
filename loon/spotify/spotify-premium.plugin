#!name=Spotify Premium
#!desc=去广告 + 解锁 Premium 状态与顺序/随机播放。直接改写 bootstrap 与 user-customization-service 的 protobuf，未知字段原样保留。
#!category=Spotify
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!tag=Spotify

[Argument]
spoof_premium = switch,true,type=boolean,tag=伪装 Premium,desc=把账号状态改写为 premium。关闭后本插件不做任何修改。
block_ads = switch,true,type=boolean,tag=去除广告,desc=关闭广告相关开关，并移除广告与推广位的远程配置。
unlock_playback = switch,true,type=boolean,tag=解锁播放限制,desc=移除试听时长上限、队列上限与强制随机等免费版限制。

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_premium.js", {${spoof_premium}, ${block_ads}, ${unlock_playback}}) with requires_body=true, binary_body_mode=true, tag="Spotify Premium", timeout=30

[MitM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com
