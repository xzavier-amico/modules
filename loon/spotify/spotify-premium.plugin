#!name=Spotify Premium
#!desc=去广告 + 解锁 Premium 状态与顺序/随机播放。直接改写 bootstrap 与 user-customization-service 的 protobuf，未知字段原样保留。
#!category=Spotify
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!tag=Spotify

[Argument]
spoof_premium = switch,true,type=boolean,tag=伪装 Premium,desc=把账号状态改写为 premium。关闭后本插件不做任何修改。
block_ads = switch,true,type=boolean,tag=去除广告,desc=关闭广告相关开关，并移除广告与推广位的远程配置。
unlock_playback = switch,true,type=boolean,tag=解锁播放限制,desc=移除试听时长上限、队列上限与强制随机等免费版限制。
lyrics_source = select,lrclib,auto,musixmatch,netease,qq,type=string,tag=歌词来源,desc=官方没有歌词时去哪个库找。lrclib 曲库全但中文偏弱；auto 依次尝试 lrclib、musixmatch、网易云、QQ 音乐。

[Rule]
# 广告域名兜底：脚本改的是服务端下发的广告开关，这里再拦一层真正投放广告的域名。
# 免费号的音频广告是服务端缝进流里的，拦域名没用；能挡的是展示位、播客外链广告和
# 广告曝光回传。doubleclick / googlesyndication 是全局域名，其它 App 也会一起被拦。
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

[Rewrite]
# UCS / extended-metadata / color-lyrics 都带 etag。客户端带 if-none-match 上来、
# 服务端回 304 时响应体是空的，脚本拿不到 body 就只能放行，客户端继续用缓存里的
# 旧值（is_lyrics_card_element_enabled=false、has_lyrics=false、404 无歌词），
# 于是改了开关也「没生效」。把校验头删掉，强制每次都拿完整响应。
request if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:user-customization-service|extended-metadata|color-lyrics)\//i then request.header.del("if-none-match")

[Script]
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service)/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_premium.js", {${spoof_premium}, ${block_ads}, ${unlock_playback}}) with requires_body=true, binary_body_mode=true, tag="Spotify Premium", timeout=30
# 把曲目元数据里的 has_lyrics 改成 true，客户端才肯去请求 color-lyrics。
# extended-metadata 是主路径（TRACK_V4 里的 Track 字段 18），context-resolve 兜底。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_meta.js") with requires_body=true, binary_body_mode=true, tag="spotify.meta", timeout=10
# 官方没有歌词时用第三方歌词补上；官方有歌词就原样放行。
# 不强制 requires_body：没有歌词时官方回 404 且 body 为空，强制读 body 脚本就不会执行。
response if ${url} ~= /^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v2\/track\//i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify/js/spotify_lyrics.js", {${lyrics_source}}) with binary_body_mode=true, tag="spotify.lyrics", timeout=10

[MitM]
hostname = *-spclient.spotify.com, spclient.wg.spotify.com
