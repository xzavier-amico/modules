#!name=Shopping Clean
#!desc=京东、淘宝、拼多多、美团、饿了么、菜鸟裹裹、丰巢去开屏、弹窗浮层与信息流竞价推广卡片。
#!category=Shopping
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/delivery.png
#!tag=Shopping

[Argument]
block_ads = switch,true,type=boolean,tag=去购物与快递广告,desc=过滤京东、淘宝、拼多多、美团、饿了么、菜鸟裹裹、丰巢的开屏、取件页弹窗浮层与搜索/推荐流里的 CPC/CPM/P4P 竞价广告。
clean_ui = switch,true,type=boolean,tag=精简金融与娱乐模块,desc=隐藏京东白条/金条/借钱、淘宝借钱/小游戏、拼多多多多视频/大转盘、菜鸟裹酱/果园/商品流等营销模块。

[Rule]
# 阻止 QUIC (HTTP/3)，确保未开全局禁 QUIC 的客户端也能回退 HTTPS 走 MITM
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, taobao.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, tmall.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, cainiao.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, fcbox.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, pinduoduo.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, yangkeduo.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, meituan.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, sankuai.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, ele.me), (PROTOCOL, QUIC)), REJECT

# ---------- 京东广告与统计域名 ----------
DOMAIN-SUFFIX, img-x.jd.com, REJECT
DOMAIN-SUFFIX, ccc-x.jd.com, REJECT
DOMAIN-SUFFIX, c-nfa.jd.com, REJECT
DOMAIN-SUFFIX, dsp-x.jd.com, REJECT
DOMAIN-SUFFIX, bdsp.x.jd.com, REJECT
DOMAIN-SUFFIX, ads-union.jd.com, REJECT
DOMAIN-SUFFIX, jzt.jd.com, REJECT
DOMAIN-SUFFIX, addata.jd.com, REJECT
DOMAIN-SUFFIX, x.jd.com, REJECT
DOMAIN-SUFFIX, cc.m.jd.com, REJECT
DOMAIN-SUFFIX, knicks.jd.com, REJECT
DOMAIN-SUFFIX, mars.jd.com, REJECT
DOMAIN-SUFFIX, orbit.jd.com, REJECT
DOMAIN, ad.3.cn, REJECT
DOMAIN, cm.jd.com, REJECT
DOMAIN, dgstatic.jd.com, REJECT
DOMAIN, im-x.jd.com, REJECT
DOMAIN, janapi.jd.com, REJECT
DOMAIN, mercury.jd.com, REJECT
DOMAIN, saturn.jd.com, REJECT
DOMAIN, uranus.jd.com, REJECT
DOMAIN, xlog.jd.com, REJECT

# ---------- 淘宝 / 天猫 / 菜鸟裹裹 / 阿里妈妈广告与统计域名 ----------
DOMAIN-SUFFIX, atanja.tanx.com, REJECT
DOMAIN-SUFFIX, tanx.com, REJECT
DOMAIN-SUFFIX, alimama.com, REJECT
DOMAIN-SUFFIX, simba.taobao.com, REJECT
DOMAIN-SUFFIX, re.taobao.com, REJECT
DOMAIN-SUFFIX, agoodm.m.taobao.com, REJECT
DOMAIN-SUFFIX, adashx.m.taobao.com, REJECT
DOMAIN-SUFFIX, h-adashx.ut.taobao.com, REJECT
DOMAIN-SUFFIX, v6-adashx.ut.taobao.com, REJECT
DOMAIN-SUFFIX, ut.taobao.com, REJECT
DOMAIN-SUFFIX, tunion-api.m.taobao.com, REJECT
DOMAIN-SUFFIX, adash.cainiao.com, REJECT
DOMAIN-SUFFIX, log.cainiao.com, REJECT

# ---------- 丰巢广告与 DSP 域名 ----------
DOMAIN-SUFFIX, dsp.fcbox.com, REJECT
DOMAIN-SUFFIX, ad.fcbox.com, REJECT
DOMAIN-SUFFIX, track.fcbox.com, REJECT

# ---------- 拼多多广告与遥测域名 ----------
DOMAIN-SUFFIX, t-dsp.pinduoduo.com, REJECT
DOMAIN-SUFFIX, th.pinduoduo.com, REJECT
DOMAIN-SUFFIX, ta.pinduoduo.com, REJECT
DOMAIN-SUFFIX, meta.pinduoduo.com, REJECT
DOMAIN-SUFFIX, log.pinduoduo.com, REJECT
DOMAIN-SUFFIX, m-ad.pinduoduo.com, REJECT

# ---------- 美团与饿了么广告与统计域名 ----------
DOMAIN-SUFFIX, impdsp.meituan.com, REJECT
DOMAIN-SUFFIX, ad.e.waimai.sankuai.com, REJECT
DOMAIN, ad.maoyan.com, REJECT
DOMAIN, analytics.meituan.net, REJECT
DOMAIN, flowplus.meituan.net, REJECT
DOMAIN, hreport.meituan.com, REJECT
DOMAIN, lx0.meituan.com, REJECT
DOMAIN, metrics.meituan.com, REJECT
DOMAIN, mtrace.meituan.com, REJECT
DOMAIN, report.meituan.com, REJECT
DOMAIN, wmlog.meituan.com, REJECT
DOMAIN-SUFFIX, adashx.ut.ele.me, REJECT
DOMAIN-SUFFIX, h-adashx.ut.ele.me, REJECT
DOMAIN-SUFFIX, v6-adashx.ut.ele.me, REJECT
DOMAIN, ad.ele.me, REJECT
DOMAIN, log.ele.me, REJECT
DOMAIN, newton.ele.me, REJECT
DOMAIN, trace.ele.me, REJECT

[Rewrite]
# 京东开屏、促销楼层网关与浮层广告接口
request if ${url} ~= /^https?:\/\/api\.m\.jd\.com\/(?:client\.action|api)\?.*functionId=(?:deliverLayer|popupConfig|adStart|getAdList|start|home_launchConfig)\b/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/homepage-gw\.jd\.com\/npromotion/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/api\.smart\.jd\.com\/c\/service\/getLoadingLinks\b/ then reject_dict(200)

# 淘宝与菜鸟裹裹开屏、弹窗及纯广告 MTOP 接口
request if ${url} ~= /^https?:\/\/(?:guide-acs|acs)\.m\.taobao\.com\/gw\/mtop\.(?:taobao\.baichuan\.smb\.get|taobao\.idle\.home\.welcome|alimama\.etao\.ad|taobao\.ad|cainiao\.adx|cainiao\.guoguo\.nbnetflow\.ads)\./ then reject_dict(200)
request if ${url} ~= /^https?:\/\/(?:acs\.m|gw)\.cainiao\.com\/gw\/mtop\.cainiao\.(?:adx|ad|guoguo\.nbnetflow\.ads|nbmensa\.research)\./ then reject_dict(200)

# 丰巢开屏、取件弹窗与横幅广告接口
request if ${url} ~= /^https?:\/\/(?:app|wx|api|m)\.fcbox\.com\/.*\/(?:ad|ads|advert|splash|openScreen|popup|marketing)(?:\/|[?]|$)/ then reject_dict(200)

# 拼多多开屏与弹窗接口
request if ${url} ~= /^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/(?:oak\/integration\/render|carnival\/image_list|cappuccino\/splash)/ then reject_dict(200)

# 美团与饿了么纯广告及开屏接口
request if ${url} ~= /^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/(?:ad|loadInfo|startpicture|openscreen)(?:[/?]|$)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/apimobile\.meituan\.com\/(?:group\/v\d+\/ad|abtest\/v\d+\/ad|appupdate\/legacy\/check)(?:[/?]|$)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/mapi\.meituan\.com\/(?:launch\/v\d+\/ad|v\d+\/ad)(?:[/?]|$)/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/rms\.meituan\.com\/diancan\/api\/queryAdBoard/ then reject_dict(200)
request if ${url} ~= /^https?:\/\/s3plus\.meituan\.net\/v1\/mss_[^/]+\/linglong\// then reject(404)
request if ${url} ~= /^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.waimai\.ad\./ then reject_dict(200)

[Script]
# 兼容京东 POST body 传 functionId、淘宝/菜鸟 MTOP、丰巢、拼多多、美团及饿了么
response if ${url} ~= /^https?:\/\/(?:api\.m\.jd\.com\/(?:client\.action|api)|(?:guide-acs|trade-acs|acs)\.m\.taobao\.com\/gw\/mtop\.|(?:acs\.m|gw)\.cainiao\.com\/gw\/mtop\.|(?:app|wx|api|m)\.fcbox\.com\/|api\.(?:pinduoduo|yangkeduo)\.com\/(?:api\/|search|v\d+\/)|(?:wmapi|apimobile|mapi|i)\.meituan\.com\/|wx\.waimai\.meituan\.com\/weapp\/|(?:waimai-guide|client-api|newton-api)\.ele\.me\/)/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/delivery/js/delivery_clean.js?v=20261123-3", {${block_ads}, ${clean_ui}}) with requires_body=true, tag="Shopping Clean", timeout=20

[MitM]
hostname = api.m.jd.com, api.smart.jd.com, homepage-gw.jd.com, guide-acs.m.taobao.com, trade-acs.m.taobao.com, acs.m.taobao.com, acs.m.cainiao.com, gw.cainiao.com, app.fcbox.com, wx.fcbox.com, api.fcbox.com, m.fcbox.com, api.pinduoduo.com, api.yangkeduo.com, wmapi.meituan.com, apimobile.meituan.com, mapi.meituan.com, i.meituan.com, rms.meituan.com, wx.waimai.meituan.com, s3plus.meituan.net, waimai-guide.ele.me, client-api.ele.me, newton-api.ele.me
h2 = true
