#!name=Shopping Clean
#!desc=京东、淘宝、菜鸟裹裹、丰巢、拼多多、美团、饿了么去开屏、弹窗浮层、素材 CDN 与信息流竞价推广卡片（阻断 HTTPDNS 绕过）。
#!category=Shopping
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/delivery.png
#!tag=Shopping

[Argument]
block_ads = switch,true,type=boolean,tag=去购物与快递广告,desc=过滤京东、淘宝、菜鸟裹裹、丰巢、拼多多、美团、饿了么的开屏、弹窗浮层与搜索/推荐流里的 CPC/CPM/P4P 竞价广告。
clean_ui = switch,true,type=boolean,tag=精简金融与娱乐模块,desc=隐藏京东大促/白条/金条/Plus 推广楼层、淘宝借钱/小游戏、拼多多多多视频/月卡入口、菜鸟裹酱/果园/非物流消息等营销模块。

[Rule]
# 阻止 QUIC (HTTP/3)，确保回退 HTTPS 走 MITM
AND, ((DOMAIN-SUFFIX, jd.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, 360buyimg.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, taobao.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, tmall.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, cainiao.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, fcbox.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, pinduoduo.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, yangkeduo.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, meituan.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, meituan.net), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, sankuai.com), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, ele.me), (PROTOCOL, QUIC)), REJECT
AND, ((DOMAIN-SUFFIX, elemecdn.com), (PROTOCOL, QUIC)), REJECT

# ---------- HTTPDNS 阻断（防止大厂 App 拿 IP 直连绕过 MITM） ----------
# 京东 HTTPDNS
DOMAIN, dns.jd.com, REJECT
IP-CIDR, 101.124.19.122/32, REJECT, no-resolve
IP-CIDR6, 2402:db40:5100:1011::5/128, REJECT, no-resolve
IP-CIDR, 103.224.222.208/32, REJECT, no-resolve
# 阿里系 HTTPDNS（注意：不全域拒绝 amdc.m.taobao.com，仅脚本对菜鸟 UA 拦截以免误伤淘宝下单）
DOMAIN, httpdns.alicdn.com, REJECT
IP-CIDR, 203.107.1.0/24, REJECT, no-resolve
# 美团 HTTPDNS
DOMAIN, httpdns.meituan.com, REJECT
DOMAIN, httpdnsmultiapi.meituan.com, REJECT
DOMAIN, httpdnsmultiapivip.meituan.com, REJECT
DOMAIN, dnspod.meituan.httpdns.qcloud.com, REJECT
IP-CIDR, 202.90.108.13/32, REJECT, no-resolve
IP-CIDR, 202.90.110.46/32, REJECT, no-resolve
IP-CIDR, 103.37.155.60/32, REJECT, no-resolve
# 拼多多 HTTPDNS
IP-CIDR, 101.35.204.35/32, REJECT, no-resolve
IP-CIDR, 101.35.212.35/32, REJECT, no-resolve
IP-CIDR, 114.110.96.26/32, REJECT, no-resolve
IP-CIDR, 114.110.97.97/32, REJECT, no-resolve

