#!name = YouTube Enhance
#!desc = Block ads. Enable background play, PiP, up to 4x speed and On-the-go controls.\nBased on Maasea's code (Apache-2.0).
#!author = gholts
#!homepage = https://github.com/gholts/surge
#!icon = https://raw.githubusercontent.com/Yuanxsxs/QtumultX/master/Icon/Hand-Painted-icon/Social_Media/YouTube.png
#!tag = YouTube
#!system = iOS,iPadOS,macOS,tvOS

[Argument]
block_upload = switch,true,type=boolean,tag=Remove upload tab,desc=Remove upload tab
block_shorts = switch,false,type=boolean,tag=Remove Shorts tab,desc=Remove Shorts tab
auto_hd = switch,true,type=boolean,tag=Auto HD,desc=Prefer highest offered resolution; Premium bitrate when authorized
block_games = switch,true,type=boolean,tag=Remove Playables,desc=Remove Playables on homepage
block_vertical_live = switch,false,type=boolean,tag=Remove vertical live,desc=Remove Vertical live on homepage
jump_ahead = switch,true,type=boolean,tag=Jump Ahead button,desc=Enable Jump Ahead button
block_store = switch,true,type=boolean,tag=Remove creator stores,desc=Remove creator stores, product cards and overlays
block_ai = switch,true,type=boolean,tag=Remove Ask / AI,desc=Remove Ask, AI summaries and related controls
on_the_go = switch,true,type=boolean,tag=On-the-go controls,desc=On-the-go controls when compatible UI components are available

[Script]
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/request.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with tag="youtube.enhance.ad-break", timeout=20
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/response.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with requires_body=true, binary_body_mode=true, tag="youtube.enhance.response", timeout=30
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/key.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with requires_body=true, binary_body_mode=true, tag="youtube.enhance.key", timeout=20
response if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/ump.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with requires_body=true, binary_body_mode=true, tag="youtube.enhance.ump", timeout=60
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/request.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with requires_body=true, binary_body_mode=true, tag="youtube.enhance.init", timeout=30, enable=${auto_hd}
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/request.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with requires_body=true, binary_body_mode=true, tag="youtube.enhance.auto-hd", timeout=30, enable=${auto_hd}
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$/ then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/youtube/js/request.js", {${block_upload}, ${block_shorts}, ${block_games}, ${block_vertical_live}, ${jump_ahead}, ${auto_hd}, ${block_store}, ${block_ai}, ${on_the_go}}) with tag="youtube.enhance.log-event", timeout=20
[Rewrite]
request if ${url} ~= /^https:\/\/www\.youtube\.com\/(pagead|pcs)\// then reject(404)
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/ads/ then reject(404)

[MitM]
hostname = *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com