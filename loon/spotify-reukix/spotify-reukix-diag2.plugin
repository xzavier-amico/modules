#!name = Spotify AD (Reukix) Diag2
#!desc = 诊断版 2：MitM 排除 guc3-spclient.spotify.com，测试 playplay/audio-key 的 H2 处理是否导致第二首卡顿
#!author = app2smile, Reukix, xzavier-amico
#!homepage = https://github.com/Reukix/ukix
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!tag = Spotify
#!loon_version = 3.5.3
#!date = 2026-11-03

[Rule]
DOMAIN,aet.spotify.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/user-customization-service\/v1\/customize$/i then request.header.del("if-none-match")

[Script]
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/3128d8059004407bf350ce2101b524cfc464bd8e/loon/spotify-reukix/js/Spotify-proto-min.js") with requires_body=true, binary_body_mode=true, tag="Spotify-proto-min", timeout=30

[MitM]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com, -guc3-spclient.spotify.com
