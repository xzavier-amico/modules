#!name = Spotify AD (Reukix)
#!desc = 去除 Spotify 广告并解锁 Premium 功能（Reukix 精简稳定版，适配 Loon 3.5.3+）
#!author = app2smile, Reukix, xzavier-amico
#!homepage = https://github.com/Reukix/ukix
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!tag = Spotify
#!loon_version = 3.5.3
#!date = 2026-11-03

[Rule]
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Rewrite]
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/user-customization-service\/v1\/customize$/i then request.header.del("if-none-match")
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/pendragon/i then reject(404)
request if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/pam-view-service\//i then reject(404)
request if ${url} ~= /^https:\/\/.*37i9dQZF1EYkqdzj48dyYq/i then reject(404)
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/gabo-receiver-service/i then response.body.mock("text", "", 200)

[Script]
response if ${url} ~= /^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?\/(?:bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$/i then script("https://raw.githubusercontent.com/xzavier-amico/modules/master/loon/spotify-reukix/js/Spotify-proto.js") with requires_body=true, binary_body_mode=true, tag="Spotify-proto", timeout=30

[MitM]
hostname = spclient.wg.spotify.com, *-spclient.spotify.com
