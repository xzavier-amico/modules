#!name=本机服务回环
#!desc=把发往 10.7.0.1 的连接反射回本机（reflect），用于在 iPhone / iPad 上访问设备自己的本地开发服务，例如 localhost 的 HTTP 服务、调试端口或内嵌 Web 服务。需要 Loon 的 TUN 生效。
#!category=开发工具
#!author=xzavier-amico
#!homepage=https://github.com/xzavier-amico/modules
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Loop.png
#!tag=Local Reflect

# 用途：把发往 10.7.0.1 的连接反射回本机。
# 只把 10.7.0.1 纳入 TUN；10.7.0.2 的规则已移除。
# 用法：在 App 或浏览器里访问 http://10.7.0.1:<端口>，连接会被反射到本机同名端口。

[General]
ipv6-vif = off
include-tun = 10.7.0.1/32

[IP Rewrite]
10.7.0.1 = reflect
