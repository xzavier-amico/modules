^https?:\/\/(?:consumer|app|wx|api|m)\.fcbox\.com\/.*\/(?:ad|ads|advert|splash|openScreen|popup|marketing)(?:\/|[?]|$) reject-dict
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/(?:cappuccino\/splash|carnival\/image_list|aquarius\/hungary\/global\/(?:app_popup|homepage)|flow\/hungary\/window\/global|zaire_biz\/chat\/resource\/get_list_data|brand-olay\/goods_detail\/bybt_guide|pdd_live_moore_main_lego) reject-dict
