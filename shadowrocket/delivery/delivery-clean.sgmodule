#!name=Delivery Clean
#!desc=美团、饿了么、京东去开屏、弹窗与信息流推广卡片。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/delivery.png
#!arguments=去广告:true, 精简金融楼层:false
#!arguments-desc=去广告：过滤美团、饿了么、京东的开屏、弹窗浮层与商家/商品流里的竞价推广卡片。\n精简金融楼层：在京东「我的」页额外隐藏白条、金条、借钱等金融营销楼层。

[Rule]
AND,((DOMAIN-SUFFIX,jd.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,meituan.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,sankuai.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,ele.me),(PROTOCOL,QUIC)),REJECT
DOMAIN,ad.e.waimai.sankuai.com,REJECT
DOMAIN,ad.maoyan.com,REJECT
DOMAIN,analytics.meituan.net,REJECT
DOMAIN,flowplus.meituan.net,REJECT
DOMAIN,hreport.meituan.com,REJECT
DOMAIN,lx0.meituan.com,REJECT
DOMAIN,metrics.meituan.com,REJECT
DOMAIN,mtrace.meituan.com,REJECT
DOMAIN,report.meituan.com,REJECT
DOMAIN,wmlog.meituan.com,REJECT
DOMAIN,ad.ele.me,REJECT
DOMAIN,log.ele.me,REJECT
DOMAIN,newton.ele.me,REJECT
DOMAIN,trace.ele.me,REJECT
DOMAIN,ad.3.cn,REJECT
DOMAIN,ads-union.jd.com,REJECT
DOMAIN,bdsp.x.jd.com,REJECT
DOMAIN,cm.jd.com,REJECT
DOMAIN,dsp-x.jd.com,REJECT
DOMAIN,dgstatic.jd.com,REJECT
DOMAIN,im-x.jd.com,REJECT
DOMAIN,janapi.jd.com,REJECT
DOMAIN,jzt.jd.com,REJECT
DOMAIN,knicks.jd.com,REJECT
DOMAIN,mercury.jd.com,REJECT
DOMAIN,orbit.jd.com,REJECT
DOMAIN,saturn.jd.com,REJECT
DOMAIN,uranus.jd.com,REJECT
DOMAIN,x.jd.com,REJECT
DOMAIN,xlog.jd.com,REJECT

[URL Rewrite]
^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/(?:ad|loadInfo|startpicture|openscreen)(?:[/?]|$) reject-dict
^https?:\/\/apimobile\.meituan\.com\/(?:group\/v\d+\/ad|abtest\/v\d+\/ad|appupdate\/legacy\/check)(?:[/?]|$) reject-dict
^https?:\/\/mapi\.meituan\.com\/(?:launch\/v\d+\/ad|v\d+\/ad)(?:[/?]|$) reject-dict
^https?:\/\/s3plus\.meituan\.net\/v1\/mss_[^/]+\/linglong\/ reject
^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.waimai\.ad\. reject-dict
^https?:\/\/api\.m\.jd\.com\/client\.action\?.*functionId=(?:deliverLayer|popupConfig|adStart|getAdList)\b reject-dict
^https?:\/\/api\.smart\.jd\.com\/c\/service\/getLoadingLinks\b reject-dict

[Script]
delivery.clean = type=http-response,pattern=^https?:\/\/(?:api\.m\.jd\.com\/client\.action\?.*functionId=(?:start|home_launchConfig|splash|welcomeHome|personinfoBusiness|search|uniformRecommend|wareBusiness)|(?:wmapi|apimobile|mapi)\.meituan\.com\/(?:api|group)\/v\d+\/|wx\.waimai\.meituan\.com\/weapp\/v\d+\/|waimai-guide\.ele\.me\/h5\/mtop\.),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/delivery/js/delivery_clean.js?v=20261123-1,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{精简金融楼层}}}}"

[MITM]
hostname = %APPEND% api.m.jd.com, api.smart.jd.com, wmapi.meituan.com, apimobile.meituan.com, mapi.meituan.com, wx.waimai.meituan.com, s3plus.meituan.net, waimai-guide.ele.me
h2 = true
