[URL Rewrite]
^https?:\/\/api\.m\.jd\.com\/(?:client\.action|api)\?.*functionId=(?:deliverLayer|popupConfig|adStart|getAdList|start|home_launchConfig)\b reject-dict
^https?:\/\/homepage-gw\.jd\.com\/npromotion reject-dict
^https?:\/\/api\.smart\.jd\.com\/c\/service\/getLoadingLinks\b reject-dict
^https?:\/\/(?:guide-acs|acs)\.m\.taobao\.com\/gw\/mtop\.(?:taobao\.baichuan\.smb\.get|taobao\.idle\.home\.welcome|alimama\.etao\.ad|taobao\.ad|cainiao\.adx|cainiao\.guoguo\.nbnetflow\.ads)\. reject-dict
^https?:\/\/(?:acs\.m|gw)\.cainiao\.com\/gw\/mtop\.cainiao\.(?:adx|ad|guoguo\.nbnetflow\.ads|nbmensa\.research)\. reject-dict
^https?:\/\/(?:app|wx|api|m)\.fcbox\.com\/.*\/(?:ad|ads|advert|splash|openScreen|popup|marketing)(?:\/|[?]|$) reject-dict
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/(?:oak\/integration\/render|carnival\/image_list|cappuccino\/splash) reject-dict
^https?:\/\/wmapi\.meituan\.com\/api\/v\d+\/(?:ad|loadInfo|startpicture|openscreen)(?:[/?]|$) reject-dict
^https?:\/\/apimobile\.meituan\.com\/(?:group\/v\d+\/ad|abtest\/v\d+\/ad|appupdate\/legacy\/check)(?:[/?]|$) reject-dict
^https?:\/\/mapi\.meituan\.com\/(?:launch\/v\d+\/ad|v\d+\/ad)(?:[/?]|$) reject-dict
^https?:\/\/rms\.meituan\.com\/diancan\/api\/queryAdBoard reject-dict
^https?:\/\/s3plus\.meituan\.net\/v1\/mss_[^/]+\/linglong\/ reject
^https?:\/\/waimai-guide\.ele\.me\/h5\/mtop\.alsc\.waimai\.ad\. reject-dict

[Script]
shopping.clean = type=http-response,pattern=^https?:\/\/(?:api\.m\.jd\.com\/(?:client\.action|api)|(?:guide-acs|trade-acs|acs)\.m\.taobao\.com\/gw\/mtop\.|(?:acs\.m|gw)\.cainiao\.com\/gw\/mtop\.|(?:app|wx|api|m)\.fcbox\.com\/|api\.(?:pinduoduo|yangkeduo)\.com\/(?:api\/|search|v\d+\/)|(?:wmapi|apimobile|mapi|i)\.meituan\.com\/|wx\.waimai\.meituan\.com\/weapp\/|(?:waimai-guide|client-api|newton-api)\.ele\.me\/),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/delivery/js/delivery_clean.js?v=20261123-3,argument="{"block_ads":{{{去购物与快递广告}}},"clean_ui":{{{精简金融与娱乐模块}}}}"

[MITM]
hostname = %APPEND% api.m.jd.com, api.smart.jd.com, homepage-gw.jd.com, guide-acs.m.taobao.com, trade-acs.m.taobao.com, acs.m.taobao.com, acs.m.cainiao.com, gw.cainiao.com, app.fcbox.com, wx.fcbox.com, api.fcbox.com, m.fcbox.com, api.pinduoduo.com, api.yangkeduo.com, wmapi.meituan.com, apimobile.meituan.com, mapi.meituan.com, i.meituan.com, rms.meituan.com, wx.waimai.meituan.com, s3plus.meituan.net, waimai-guide.ele.me, client-api.ele.me, newton-api.ele.me
h2 = true
