[Script]
shopping.amdc = type=http-request,pattern=^https?:\/\/amdc\.m\.taobao\.com\/amdc\/mobileDispatch$,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/delivery/js/delivery_clean.js?v=20261124-1,argument="{"block_ads":{{{去购物与快递广告}}},"clean_ui":{{{精简金融与娱乐模块}}}}"
shopping.clean = type=http-response,pattern=^https?:\/\/(?:api\.m\.jd\.com\/(?:client\.action|api)|(?:guide-acs|trade-acs|acs)\.m\.taobao\.com\/gw\/mtop\.|poplayer\.template\.alibaba\.com\/\w+\.json|(?:cn-acs|acs)\.m\.cainiao\.com\/gw\/mtop\.|netflow-mtop\.cainiao\.com\/gw\/mtop\.|(?:consumer|app|wx|api|m)\.fcbox\.com\/|api\.(?:pinduoduo|yangkeduo)\.com\/(?:api\/|search|v\d+\/)|(?:wmapi|apimobile|mapi|i)\.meituan\.com\/|wx\.waimai\.meituan\.com\/(?:weapp|api\/miniprogram)\/|waimai-guide\.ele\.me\/),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/delivery/js/delivery_clean.js?v=20261124-1,argument="{"block_ads":{{{去购物与快递广告}}},"clean_ui":{{{精简金融与娱乐模块}}}}"

