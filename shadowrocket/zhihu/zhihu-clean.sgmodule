#!name=Zhihu Clean
#!desc=知乎去开屏、推荐流伪装广告、回答页夹层广告与评论区推广。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/zhihu.png
#!arguments=去广告:true, 过滤盐选推广:false
#!arguments-desc=去广告：过滤知乎开屏、首页推荐流 feed_advert、回答夹层 ad_info 与评论区插件广告。\n过滤盐选推广：额外过滤推荐流里的盐选故事、知乎严选与训练营营销卡片，以及回答页带货卡。

[Rule]
AND,((DOMAIN-SUFFIX,zhihu.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,appcloud2.in.zhihu.com,REJECT
DOMAIN,crash2.zhihu.com,REJECT
DOMAIN,mqtt.zhihu.com,REJECT
DOMAIN,sugar.zhihu.com,REJECT

[URL Rewrite]
^https?:\/\/api\.zhihu\.com\/(?:commercial_api\/(?:ad_float_layer|banners|egg_payload)|ad-style-service\/|fringe\/ad) reject-dict
^https?:\/\/api\.zhihu\.com\/api\/v4\/(?:PresetWords|search\/preset_words)\b reject-dict

[Script]
zhihu.clean = type=http-response,pattern=^https?:\/\/(?:api|www)\.zhihu\.com\/(?:commercial_api\/(?:launch_v2|real_time_launch_v2)|(?:v2\/)?topstory\/(?:recommend|hot-lists)|api\/v4\/(?:questions\/[^/]+\/answers|answers\/|comment(?:_v5|s)\/|search)|next-(?:bff|data|render))(?:[/?]|$),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/zhihu/js/zhihu_clean.js?v=20261123-1,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{过滤盐选推广}}}}"

[MITM]
hostname = %APPEND% api.zhihu.com, www.zhihu.com
h2 = true
