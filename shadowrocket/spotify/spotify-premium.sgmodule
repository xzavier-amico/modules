#!name=Spotify Premium
#!desc=去广告 + 解锁 Premium 状态与顺序/随机播放，并可用第三方歌词补全 Now Playing 界面。
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Spotify.png
#!arguments=伪装Premium:true, 去除广告:true, 解锁播放限制:true, 补全歌词:true, 歌词来源:lrclib
#!arguments-desc=歌词来源：lrclib / auto / musixmatch / netease / qq\n补全歌词关闭后脚本会直接放行，不再请求第三方歌词库。

[Rule]
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,pubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,securepubads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,googleads.g.doubleclick.net,REJECT
DOMAIN-SUFFIX,pagead2.googlesyndication.com,REJECT
DOMAIN-SUFFIX,tpc.googlesyndication.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,www.googletagservices.com,REJECT

[Header Rewrite]
# UCS / extended-metadata / color-lyrics 都带 etag，304 时脚本拿不到 body，改动不生效。
http-request ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:user-customization-service|extended-metadata|color-lyrics)\/ header-del if-none-match

[Script]
# extended-metadata 的 etag 在请求体里，请求阶段先抹掉。
spotify.meta.req = type=http-request,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/extended-metadata\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261107-8,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}}}"
# 改写 bootstrap / user-customization-service 里的账号状态与远程配置。
spotify.premium = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service),requires-body=1,binary-body-mode=1,max-size=41943040,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261107-8,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}}}"
# 把曲目元数据里的 has_lyrics 改成 true，客户端才肯去请求 color-lyrics。
spotify.meta = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261107-8,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}}}"
# 官方没有歌词时用第三方歌词补上。不强制 requires-body：404 时 body 为空，脚本仍要执行。
spotify.lyrics = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\/,binary-body-mode=1,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify_lyrics.js?v=20261107-8,argument="{"lyrics_source":"{{{歌词来源}}}","enable_lyrics":{{{补全歌词}}}}"

[MITM]
hostname = %APPEND% *-spclient.spotify.com, spclient.wg.spotify.com
