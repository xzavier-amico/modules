#!name=Spotify Enhance
#!desc=去广告、解锁 Premium 播放限制，并用第三方歌词补全 Now Playing 与歌词卡。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/spotify.png
#!arguments=伪装Premium:true, 去除广告:true, 解锁播放限制:true, 补全歌词:true, 歌词来源:auto, 歌词字形:hans, 忽略简繁:true, 纯文本伪同步:true, ISRC反查:true, 预取下一首:true
#!arguments-desc=歌词来源：auto（默认，并发查询网易云 / QQ / LRCLIB）/ lrclib / musixmatch / netease / qq\n歌词字形：hans（默认，把官方与第三方歌词都转成简体，官方 language 同步改成 zh-Hans）/ source（保持原文）。\n忽略简繁：查歌词时把繁体曲名 / 歌手按简体比较；关闭后繁简写法必须完全一致。\n纯文本伪同步：只有纯文本歌词时按歌曲时长把每行均分到时间轴上，让它能跟着滚动；关闭则只按纯文本显示。\nISRC 反查：前几轮都没搜到时用 Deezer 公开接口反查 ISRC，再用 ISRC 直查 Musixmatch、并用规范曲名重查曲库。\n预取下一首：打开 Now Playing 时把队列里下一首的歌词先查好写进缓存，切歌后直接命中，不阻塞卡片渲染。\n关闭补全歌词后脚本会直接放行，不再请求第三方歌词库。

[Rule]
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
# 歌词源直连：网易云 / QQ 音乐在国内，走代理反而多绕一圈。
DOMAIN,music.163.com,DIRECT
DOMAIN,c.y.qq.com,DIRECT
# 强制 Spotify 的 QUIC 回落到 TCP，确保请求经过 HTTP 代理。
# 个别版本拒绝 QUIC 后可能跳歌，遇到时再调整这条规则。
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT

[URL Rewrite]
# 纯广告路径。桌面端和播放器核心会请求 /ads/*、/ad-logic/*、ad-on-app-open，
# Premium 推广会请求 /premium-marketing/upsellOffer；iOS 不请求这些路径，保留不影响。
# 不要拦 /social、gabo、pendragon：它们分别是好友动态、事件上报与消息服务。
^https:\/\/(?:spclient\.wg|[a-z0-9]+-spclient)\.spotify\.com(?::443)?\/ad- - reject
^https:\/\/(?:spclient\.wg|[a-z0-9-]+-spclient)\.spotify\.com(?::443)?(?:\/ads\/|\/premium-marketing\/|[^?#]*\/ad-on-app-open) - reject

[Header Rewrite]
# 删除 if-none-match，避免 304 空响应导致脚本拿不到 body。
http-request ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|extended-metadata|metadata\/4\/track|color-lyrics|remote-config-resolver|nebula|casita|browsita|scrollsita)\/ header-del if-none-match

[Script]
# 请求头 / 时区：按账号地区改写 URL 里的 timezone（固定开启）。
spotify.headers = type=http-request,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/,timeout=5,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.headers.js?v=20261114-26
# 删除 extended-metadata 请求体里的 etag。
spotify.meta.req = type=http-request,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/extended-metadata\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261123-40,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","prefetch_lyrics":{{{预取下一首}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"
# 改写账号状态与远程配置。
spotify.enhance = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service),requires-body=1,binary-body-mode=1,max-size=41943040,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261123-40,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","prefetch_lyrics":{{{预取下一首}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"
# 将曲目元数据里的 has_lyrics 改为 true，客户端才会请求 color-lyrics。
spotify.meta = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261123-40,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","prefetch_lyrics":{{{预取下一首}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"
# 改写 bootstrap 之后重新拉取的远程配置与账号属性。
spotify.config = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:remote-config-resolver|nebula)\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261123-40,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","prefetch_lyrics":{{{预取下一首}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"
# 过滤首页 / 搜索 / 滚动页赞助内容，并补歌词 section。
spotify.feed = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:casita\/v\d+\/home|browsita\/v\d+\/browse|scrollsita\/v\d+\/scroll),requires-body=1,binary-body-mode=1,max-size=12582912,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.feed.js?v=20261123-3,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","prefetch_lyrics":{{{预取下一首}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"
# 请求阶段：缓存里已有这首歌的第三方歌词时直接返回，跳过可能很慢的官方请求。
spotify.lyrics.req = type=http-request,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\/,binary-body-mode=1,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify_lyrics.js?v=20261119-2,argument="{"lyrics_source":"{{{歌词来源}}}","enable_lyrics":{{{补全歌词}}},"lyrics_script":"{{{歌词字形}}}","ignore_han_variants":{{{忽略简繁}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"
# 官方有歌词时按歌词字形设置转简体（默认），没有时用第三方歌词补全。
# requires-body 必须开：Shadowrocket 不开这个开关时既不把响应 body 交给脚本，也不接受
# 脚本返回的 body，补出来的歌词会被丢掉（表现为「查到了歌词但不显示」）。
# 没有 body 的 404 / 200 空响应照样会进脚本，由脚本自己判断。
spotify.lyrics = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\/,requires-body=1,binary-body-mode=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify_lyrics.js?v=20261119-2,argument="{"lyrics_source":"{{{歌词来源}}}","enable_lyrics":{{{补全歌词}}},"lyrics_script":"{{{歌词字形}}}","ignore_han_variants":{{{忽略简繁}}},"sync_plain_lyrics":{{{纯文本伪同步}}},"lyrics_isrc":{{{ISRC反查}}}}"

[MITM]
hostname = %APPEND% *-spclient.spotify.com, spclient.wg.spotify.com
# spclient 走 HTTP/2；不开 h2 MITM 时 requires-body 拿不到 body，脚本只能原样放行。
h2 = true
