#!name=Spotify Enhance
#!desc=去广告、解锁 Premium 播放限制，并用第三方歌词补全 Now Playing 与歌词卡。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/spotify.png
#!arguments=伪装Premium:true, 去除广告:true, 解锁播放限制:true, 补全歌词:true, 歌词来源:auto, 排障日志:false
#!arguments-desc=歌词来源：auto（默认，并发查询网易云 / QQ / LRCLIB）/ lrclib / musixmatch / netease / qq\n关闭补全歌词后脚本会直接放行，不再请求第三方歌词库。\n排障日志会输出歌词卡与元数据缓存的时序日志（含曲名），排查完请关闭。

[Rule]
DOMAIN-SUFFIX,ads.spotify.com,REJECT
DOMAIN-SUFFIX,adeventtracker.spotify.com,REJECT
DOMAIN-SUFFIX,aet.spotify.com,REJECT
# 歌词源直连：网易云 / QQ 音乐在国内，走代理反而多绕一圈。
DOMAIN,music.163.com,DIRECT
DOMAIN,c.y.qq.com,DIRECT
# 强制 Spotify 的 QUIC 回落到 TCP，确保请求经过 HTTP 代理。
# 个别版本拒绝 QUIC 后可能跳歌，遇到时再调整这条规则。
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT

[Header Rewrite]
# 删除 if-none-match，避免 304 空响应导致脚本拿不到 body。
http-request ^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service|extended-metadata|color-lyrics|remote-config-resolver|nebula|casita|browsita|scrollsita)\/ header-del if-none-match

[Script]
# 删除 extended-metadata 请求体里的 etag。
spotify.meta.req = type=http-request,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/extended-metadata\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261114-20,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","debug_log":{{{排障日志}}}}"
# 改写账号状态与远程配置。
spotify.enhance = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:bootstrap|user-customization-service),requires-body=1,binary-body-mode=1,max-size=41943040,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261114-20,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","debug_log":{{{排障日志}}}}"
# 将曲目元数据里的 has_lyrics 改为 true，客户端才会请求 color-lyrics。
spotify.meta = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:extended-metadata|context-resolve|connect-state|metadata\/4\/track)\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261114-20,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","debug_log":{{{排障日志}}}}"
# 改写 bootstrap 之后重新拉取的远程配置与账号属性。
spotify.config = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:remote-config-resolver|nebula)\/,requires-body=1,binary-body-mode=1,max-size=12582912,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.js?v=20261114-20,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","debug_log":{{{排障日志}}}}"
# 过滤首页 / 搜索 / 滚动页赞助内容，并补歌词 section。
spotify.feed = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/(?:casita\/v\d+\/home|browsita\/v\d+\/browse|scrollsita\/v\d+\/scroll),requires-body=1,binary-body-mode=1,max-size=12582912,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify.feed.js?v=20261114-21,argument="{"spoof_premium":{{{伪装Premium}}},"block_ads":{{{去除广告}}},"unlock_playback":{{{解锁播放限制}}},"enable_lyrics":{{{补全歌词}}},"lyrics_source":"{{{歌词来源}}}","debug_log":{{{排障日志}}}}"
# 请求阶段：缓存里已有这首歌的第三方歌词时直接返回，跳过可能很慢的官方请求。
spotify.lyrics.req = type=http-request,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\/,binary-body-mode=1,max-size=2097152,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify_lyrics.js?v=20261114-20,argument="{"lyrics_source":"{{{歌词来源}}}","enable_lyrics":{{{补全歌词}}},"debug_log":{{{排障日志}}}}"
# 官方有歌词时原样放行，没有时用第三方歌词补全。
# 不启用 requires-body：官方 404 时没有 body，脚本仍需执行。
spotify.lyrics = type=http-response,pattern=^https:\/\/(?:\w+-spclient|spclient\.wg)\.spotify\.com(?::443)?\/color-lyrics\/v\d\/track\/,binary-body-mode=1,max-size=2097152,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/spotify/js/spotify_lyrics.js?v=20261114-20,argument="{"lyrics_source":"{{{歌词来源}}}","enable_lyrics":{{{补全歌词}}},"debug_log":{{{排障日志}}}}"

[MITM]
hostname = %APPEND% *-spclient.spotify.com, spclient.wg.spotify.com
