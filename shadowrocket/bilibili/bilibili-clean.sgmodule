#!name=BiliBili Clean
#!desc=去广告、去会员推广、去遥测，播放请求自动要最高画质。JSON 与 gRPC 都改，不碰视频流。
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/bilibili.png
#!arguments=去广告:true, 去会员推广:true, 自动最高画质:true
#!arguments-desc=去广告：删除开屏、首页推荐、搜索、番剧页、直播推荐、番剧弹窗、详情页、评论区和暂停广告。\n去会员推广：删除番剧页 payment 块、大会员广告素材和 VIP 卡片。\n自动最高画质：把 playurl 的 qn 改成 120（4K），服务端按账号权限返回实际最高档。

[Rule]
# 遥测与广告
DOMAIN,data.bilibili.com,REJECT
DOMAIN,cm.bilibili.com,REJECT
DOMAIN,adtrack.qianwen.com,REJECT
DOMAIN,tkio-redirect.solar-engine.com,REJECT

[URL Rewrite]
# 点击埋点
^https?:\/\/api\.bilibili\.com\/x\/report\/click\/ reject

[Script]
bilibili.clean = type=http-response,pattern=^https?:\/\/(?:app\.bilibili\.com|api\.bilibili\.com|api\.live\.bilibili\.com)\/(?:x\/v2\/splash\/|x\/v2\/feed\/index|x\/v2\/search\/square|x\/web-interface\/wbi\/index\/top\/feed\/rcmd|x\/vip\/ads\/materials|pgc\/view\/v2\/app\/season|pgc\/page\/|pgc\/activity\/deliver\/material\/receive|xlive\/(?:app-interface\/v2\/(?:index\/feed|room\/recList)|app-room\/v1\/index\/getInfoByRoom)),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/bilibili/js/bilibili_clean.js,argument="{"block_ads":{{{去广告}}},"hide_vip":{{{去会员推广}}}}"
bilibili.quality = type=http-request,pattern=^https?:\/\/(?:api|app)\.bilibili\.com\/.*playurl,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/bilibili/js/bilibili_quality.js,argument="{"auto_quality":{{{自动最高画质}}}}"
# 详情页 / 评论区 / 播放器走 gRPC（protobuf over HTTP/2），需要二进制 body。
bilibili.grpc = type=http-response,pattern=^https?:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:view|viewunite)\.v1\.View|main\.community\.reply\.v1\.Reply)\/,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/bilibili/js/bilibili_grpc.js,argument="{"block_ads":{{{去广告}}}}"

[MITM]
hostname = %APPEND% app.bilibili.com, api.bilibili.com, api.live.bilibili.com, grpc.biliapi.net
