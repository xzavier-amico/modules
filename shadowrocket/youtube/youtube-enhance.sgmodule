#!name=YouTube Enhance
#!desc=屏蔽广告、字幕翻译、YouTube Music 去广告/后台播放、默认分辨率、首页菜单、Shorts 与新闻/图文推荐过滤；可选清理播放器结束推荐墙/信息卡、评论区/相关视频、自动播放与自动字幕，支持编码偏好；后台播放与 PiP 常开。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/youtube.png
#!arguments=屏蔽广告:true, 移除AI组件:true, 默认分辨率:max, 字幕翻译:zh-Hans, 首页菜单保留项:-upload, 移除Shorts推荐:false, 移除新闻图文推荐:false, YouTubeMusic增强:true, 屏蔽会员专属视频:false, 首页内容清理:standard, JumpAhead:true, 最大倍速:4, 支持网页版:true, 播放器清理:off, 字幕开关:keep, 信息流清理:off, 播放页清理:off, 编码偏好:any, 网页版顶部按钮:false, Music锁音质:false, 排障日志:off
#!arguments-desc=默认分辨率：max / 4320 / 2160 / 1440 / 1080 / 720 / 480 / off\n字幕翻译：语言代码或 off\n首页菜单保留项：-upload 只隐藏上传（留空同义）；all 全保留；none 全隐藏；-shorts 只隐藏 Shorts\n移除Shorts推荐：移除货架和混在推荐流里的单个 Shorts 卡片\n移除新闻图文推荐：移除推荐流里的新闻、社区图文帖子等非视频卡片（按版式名 / element 标识判断，不看标题文案）\n首页内容清理：standard / all / off\n最大倍速：4 / 3 / 2 / off\n支持网页版：同时处理 www.youtube.com / m.youtube.com / music.youtube.com 的 YouTube 与 YouTube Music 网页\n播放器清理：off / standard（去结束推荐墙与信息卡，网页版）/ all（再关自动播放下一首）\n字幕开关：keep / off（去掉自动生成字幕）/ force（强制开启）\n信息流清理：off / standard（去继续观看与筛选条）/ all（再去直播、首映卡片）\n播放页清理：off / comments（去评论区）/ all（再去相关视频）\n编码偏好：any / no_av1 / avc\n网页版顶部按钮：隐藏 Create / 通知 / 上传\n排障日志：off / on（打字段号、版式名、内部标识）/ full（再打卡片开头 hex）

[Rule]
# 拒绝 QUIC，强制回落 TCP。HTTP/3 不经过 HTTP 代理，脚本拿不到 ad_break / player 请求。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT

[Script]
# 请求阶段：ad_break / log_event 不需要请求体。
youtube.request.meta = type=http-request,pattern=^https:\/\/(?:youtubei\.googleapis\.com|(?:www|m)\.youtube\.com|music\.youtube\.com)\/youtubei\/v1\/(?:(?:player|music)\/ad_break|log_event)(?:\?.*)?$,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.request.js?v=20261118-1,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}},"blockFeedCards":{{{移除新闻图文推荐}}},"playerCleanup":"{{{播放器清理}}}","captionsMode":"{{{字幕开关}}}","feedCleanup":"{{{信息流清理}}}","watchCleanup":"{{{播放页清理}}}","videoCodec":"{{{编码偏好}}}","webCleanup":{{{网页版顶部按钮}}},"musicCleanup":{{{Music锁音质}}},"probe":{{{排障日志}}}}"
# 请求阶段：initplayback / videoplayback 需要请求体。
youtube.request.playback = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/(?:initplayback|videoplayback)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.request.js?v=20261118-1,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}},"blockFeedCards":{{{移除新闻图文推荐}}},"playerCleanup":"{{{播放器清理}}}","captionsMode":"{{{字幕开关}}}","feedCleanup":"{{{信息流清理}}}","watchCleanup":"{{{播放页清理}}}","videoCodec":"{{{编码偏好}}}","webCleanup":{{{网页版顶部按钮}}},"musicCleanup":{{{Music锁音质}}},"probe":{{{排障日志}}}}"
# 响应阶段：config / log_event 只做 UMP 密钥提取。
youtube.key = type=http-response,pattern=^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.key.js?v=20261118-1
# 响应阶段：browse / next / player 等常规接口。
youtube.response = type=http-response,pattern=^https:\/\/(?:youtubei\.googleapis\.com|(?:www|m)\.youtube\.com|music\.youtube\.com)\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=60,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.response.js?v=20261118-1,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}},"blockFeedCards":{{{移除新闻图文推荐}}},"playerCleanup":"{{{播放器清理}}}","captionsMode":"{{{字幕开关}}}","feedCleanup":"{{{信息流清理}}}","watchCleanup":"{{{播放页清理}}}","videoCodec":"{{{编码偏好}}}","webCleanup":{{{网页版顶部按钮}}},"musicCleanup":{{{Music锁音质}}},"probe":{{{排障日志}}}}"
# 响应阶段：initplayback 的 UMP 解密。
youtube.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=5242880,timeout=60,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.response.js?v=20261118-1,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}},"blockFeedCards":{{{移除新闻图文推荐}}},"playerCleanup":"{{{播放器清理}}}","captionsMode":"{{{字幕开关}}}","feedCleanup":"{{{信息流清理}}}","watchCleanup":"{{{播放页清理}}}","videoCodec":"{{{编码偏好}}}","webCleanup":{{{网页版顶部按钮}}},"musicCleanup":{{{Music锁音质}}},"probe":{{{排障日志}}}}"

[URL Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads reject

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, music.youtube.com, s.youtube.com
