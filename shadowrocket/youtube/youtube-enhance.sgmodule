#!name=YouTube Enhance
#!desc=屏蔽广告、字幕翻译、YouTube Music 去广告/后台播放、默认分辨率、首页菜单与 Shorts 过滤、On-the-go；后台播放与 PiP 常开。\n脚本已重写并合并为单文件；原始逻辑来自 Maasea 的代码 (Apache-2.0)。
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/YouTube.png
#!arguments=屏蔽广告:true, 移除AI组件:true, 默认分辨率:max, 字幕翻译:zh-Hans, 首页菜单保留项:-upload, 移除Shorts推荐:false, OnTheGo:true, YouTubeMusic增强:true, 屏蔽会员专属视频:false, 首页内容清理:standard, JumpAhead:true, 最大倍速:4
#!arguments-desc=默认分辨率：max / 4320 / 2160 / 1440 / 1080 / 720 / 480 / off\n字幕翻译：语言代码或 off\n首页菜单保留项：-upload 只隐藏上传（留空同义）；all 全保留；none 全隐藏；-shorts 只隐藏 Shorts\n首页内容清理：standard / all / off\n最大倍速：4 / 3 / 2 / off

[Script]
youtube.enhance.request = type=http-request,pattern=^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/(?:(?:player|music)\/ad_break|log_event)(?:\?.*)?$|^https?:\/\/[\w-]+\.googlevideo\.com\/(?:initplayback|videoplayback)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.js,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"onTheGo":{{{OnTheGo}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}"}"
youtube.enhance.response = type=http-response,pattern=^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config|log_event)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=60,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.js,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"onTheGo":{{{OnTheGo}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}"}"
youtube.enhance.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=5242880,timeout=60,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.js,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"onTheGo":{{{OnTheGo}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}"}"

[URL Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads reject

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, music.youtube.com, s.youtube.com
