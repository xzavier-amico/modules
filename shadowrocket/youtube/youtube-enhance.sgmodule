#!name=YouTube Enhance
#!desc=屏蔽广告、字幕翻译、YouTube Music 去广告/后台播放、默认分辨率、首页菜单与 Shorts 过滤；后台播放与 PiP 常开。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/youtube.png
#!arguments=屏蔽广告:true, 移除AI组件:true, 默认分辨率:max, 字幕翻译:zh-Hans, 首页菜单保留项:-upload, 移除Shorts推荐:false, YouTubeMusic增强:true, 屏蔽会员专属视频:false, 首页内容清理:standard, JumpAhead:true, 最大倍速:4, 支持网页版:true
#!arguments-desc=默认分辨率：max / 4320 / 2160 / 1440 / 1080 / 720 / 480 / off\n字幕翻译：语言代码或 off\n首页菜单保留项：-upload 只隐藏上传（留空同义）；all 全保留；none 全隐藏；-shorts 只隐藏 Shorts\n首页内容清理：standard / all / off\n最大倍速：4 / 3 / 2 / off\n支持网页版：同时处理 www.youtube.com / m.youtube.com / music.youtube.com 的 YouTube 与 YouTube Music 网页

[Rule]
# 拒绝 QUIC，强制回落 TCP。HTTP/3 不经过 HTTP 代理，脚本拿不到 ad_break / player 请求。
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,youtube.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,QUIC)),REJECT

[Script]
# 请求阶段：ad_break / log_event 不需要请求体。
youtube.request.meta = type=http-request,pattern=^https:\/\/(?:youtubei\.googleapis\.com|(?:www|m)\.youtube\.com|music\.youtube\.com)\/youtubei\/v1\/(?:(?:player|music)\/ad_break|log_event)(?:\?.*)?$,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.request.js?v=20261114-3,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}}}"
# 请求阶段：initplayback / videoplayback 需要请求体。
youtube.request.playback = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/(?:initplayback|videoplayback)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=30,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.request.js?v=20261114-3,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}}}"
# 响应阶段：config / log_event 只做 UMP 密钥提取。
youtube.key = type=http-response,pattern=^https:\/\/(?:youtubei\.googleapis\.com|music\.youtube\.com)\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=10,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.key.js?v=20261114-3
# 响应阶段：browse / next / player 等常规接口。
youtube.response = type=http-response,pattern=^https:\/\/(?:youtubei\.googleapis\.com|(?:www|m)\.youtube\.com|music\.youtube\.com)\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=8388608,timeout=60,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.response.js?v=20261114-3,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}}}"
# 响应阶段：initplayback 的 UMP 解密。
youtube.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=5242880,timeout=60,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/youtube/js/youtube.response.js?v=20261114-3,argument="{"blockAds":{{{屏蔽广告}}},"blockAi":{{{移除AI组件}}},"maxHeight":"{{{默认分辨率}}}","captionLang":"{{{字幕翻译}}}","homeMenu":"{{{首页菜单保留项}}}","blockShortsFeed":{{{移除Shorts推荐}}},"youtubeMusic":{{{YouTubeMusic增强}}},"blockMembersOnly":{{{屏蔽会员专属视频}}},"homeCleanup":"{{{首页内容清理}}}","jumpAhead":{{{JumpAhead}}},"maxSpeed":"{{{最大倍速}}}","web":{{{支持网页版}}}}"

[URL Rewrite]
^https:\/\/www\.youtube\.com\/(pagead|pcs)\/ reject
^https:\/\/s\.youtube\.com\/api\/stats\/ads reject

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, m.youtube.com, music.youtube.com, s.youtube.com
