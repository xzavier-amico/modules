#!name=Weibo Clean
#!desc=微博去开屏、时间线推广、评论区软广、发现/热搜/综合搜索广告与「我的」页任务中心/钱包营销卡片。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/weibo.png
#!arguments=去广告:true, 净化我的页:true
#!arguments-desc=去广告：过滤微博开屏、推荐/关注时间线、正文详情、评论区软广、发现页商业热搜及综合搜索广告。\n净化我的页：在「我的」页按真实 itemId 白名单彻底隐藏任务中心、红包签到、我的钱包、借钱、游戏、直播、小说、商城等杂乱卡片。

[Rule]
AND,((DOMAIN-SUFFIX,weibo.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,weibo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,weibocdn.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,sinaimg.cn),(PROTOCOL,QUIC)),REJECT
DOMAIN,dns.weibo.cn,REJECT
IP-CIDR,39.97.128.148/32,REJECT,no-resolve
IP-CIDR,39.97.130.51/32,REJECT,no-resolve
DOMAIN,aln.uve.weibo.com,REJECT
DOMAIN,click.uve.weibo.com,REJECT
DOMAIN,datacollection.uve.weibo.com,REJECT
DOMAIN,fastimage.uve.weibo.com,REJECT
DOMAIN,adimg.uve.weibo.com,REJECT
DOMAIN,ad.weibo.com,REJECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,alitui.weibo.com,REJECT
DOMAIN,biz.weibo.com,REJECT
DOMAIN,tui.weibo.com,REJECT
DOMAIN,dp.im.weibo.cn,REJECT
DOMAIN,game.weibo.cn,REJECT
DOMAIN,game.weibo.com,REJECT
DOMAIN,gw5.push.mcp.weibo.cn,REJECT
DOMAIN,gw6.push.mcp.weibo.cn,REJECT
DOMAIN,logmix.sina.cn,REJECT
DOMAIN,pay.sc.weibo.com,REJECT
DOMAIN,promote.biz.weibo.cn,REJECT
DOMAIN,sdkclick.mobile.sina.cn,REJECT
DOMAIN,trends.mobile.sina.cn,REJECT
DOMAIN,u1.img.mobile.sina.cn,REJECT
DOMAIN,wax.weibo.com,REJECT
DOMAIN,zymo.mps.weibo.com,REJECT
DOMAIN,adpinpai.video.weibocdn.com,REJECT

[URL Rewrite]
^https?:\/\/[^/]*weibo\.c(?:n|om)\/(?:2\/)?httpdns\/config reject
^https?:\/\/bootrealtime\.uve\.weibo\.com\/v\d+\/ad\/realtime reject-dict
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info|sdkconfig)\.php reject
^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:ug\/checkin\/list|push\/daily|push\/info|logservice\/service|statuses\/unread_hot_timeline_ad|statuses\/container_positive|statuses\/push_info|comments\/bullet_screens|video\/redpacket|hot\/hours_spotlight|search\/container_discover|!\/live\/media_homelist|!\/chaohua\/discovery\/home_bottom\/switch|!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)|!\/was\/finder\/searchbarchange|!\/wbox\/\w+\/(?:home_bottom_modal|interest_category)|(?:ad|sdk|preload|floater|pullad)\/) reject-dict
^https?:\/\/api\.weibo\.cn\/!\/sug\/list\/finderchange\b reject-dict
^https?:\/\/(?:card\.weibo\.com\/article\/m\/aj|weibo\.com\/ttarticle\/x\/m\/aj)\/(?:reward|uvead)\b reject-dict

[Header Rewrite]
http-request ^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:profile\/|users\/|search\/|searchall|flowpage|page|cardlist|container\/) header-del if-none-match
http-request ^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:profile\/|users\/|search\/|searchall|flowpage|page|cardlist|container\/) header-del if-modified-since

[Script]
weibo.splash = type=http-response,pattern=^https?:\/\/(?:(?:sdk|wb)app|bootpreload)\.uve\.weibo\.com\/(?:interface\/sdk\/sdkad\.php|wbapplua\/wbpullad\.lua|preload\/get_ad|v\d+\/ad\/preload),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/weibo/js/weibo_clean.js?v=20261124-1,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{净化我的页}}}}"
weibo.clean = type=http-response,pattern=^https?:\/\/(?:[\w-]+\.)?(?:api|m|mapi)\.weibo\.c(?:n|om)\/2\/(?:push\/active|client\/|checkin\/show|statuses\/|groups\/(?:timeline|allgroups\/v2)|video\/|comments\/(?:build_comments|mix_comments)|search\/|searchall|flowpage|flowlist|container\/|page|cardlist|profile\/|users\/show|direct_messages\/user_list|messageflow\/notice|!\/huati\/discovery_home_bottom_channels),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/weibo/js/weibo_clean.js?v=20261124-1,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{净化我的页}}}}"

[MITM]
hostname = %APPEND% *.weibo.cn, *.api.weibo.cn, *.uve.weibo.com, *.weibo.com, weibo.com
h2 = true
