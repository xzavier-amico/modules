#!name=Weibo Clean
#!desc=微博去开屏、时间线与评论区广告；极简发现页（仅留纯净热搜，去横幅与下方 feed 流）、清空视频页推荐流，以及极简「我的」页（去超话社区/更多功能/任务中心/钱包）。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/weibo.png
#!arguments=去广告:true, 极简界面:true
#!arguments-desc=去广告：过滤微博开屏、推荐/关注时间线、正文详情、评论区软广、商业热搜及综合搜索广告。\n极简界面：发现页仅保留热搜（清空下方横幅与全部 feed 流）；清空视频页推荐流；「我的」页移除超话社区、更多功能、任务中心、红包签到、钱包、借钱与游戏卡片。

[Rule]
AND,((DOMAIN-SUFFIX,weibo.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,weibo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,weibocdn.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,sinaimg.cn),(PROTOCOL,QUIC)),REJECT
DOMAIN,dns.weibo.cn,REJECT
IP-CIDR,39.97.128.148/32,REJECT,no-resolve
IP-CIDR,39.97.130.51/32,REJECT,no-resolve
DOMAIN,aln.uve.weibo.com,REJECT
DOMAIN,click.uve.weibo.com,REJECT
DOMAIN,datacollection.uve.weibo.com,REJECT
DOMAIN,fastimage.uve.weibo.com,REJECT
DOMAIN,adimg.uve.weibo.com,REJECT
DOMAIN,ad.weibo.com,REJECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,alitui.weibo.com,REJECT
DOMAIN,biz.weibo.com,REJECT
DOMAIN,tui.weibo.com,REJECT
DOMAIN,dp.im.weibo.cn,REJECT
DOMAIN,game.weibo.cn,REJECT
DOMAIN,game.weibo.com,REJECT
DOMAIN,gw5.push.mcp.weibo.cn,REJECT
DOMAIN,gw6.push.mcp.weibo.cn,REJECT
DOMAIN,logmix.sina.cn,REJECT
DOMAIN,pay.sc.weibo.com,REJECT
DOMAIN,promote.biz.weibo.cn,REJECT
DOMAIN,sdkclick.mobile.sina.cn,REJECT
DOMAIN,trends.mobile.sina.cn,REJECT
DOMAIN,u1.img.mobile.sina.cn,REJECT
DOMAIN,wax.weibo.com,REJECT
DOMAIN,zymo.mps.weibo.com,REJECT
DOMAIN,adpinpai.video.weibocdn.com,REJECT

[URL Rewrite]
^https?:\/\/[^/]*weibo\.c(?:n|om)\/(?:2\/)?httpdns\/config reject
^https?:\/\/bootrealtime\.uve\.weibo\.com\/v\d+\/ad\/realtime reject-dict
^https?:\/\/sdkapp\.uve\.weibo\.com\/interface\/sdk\/(?:get-lbs-cell-info|sdkconfig)\.php reject
^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:ug\/checkin\/list|push\/daily|push\/info|logservice\/service|statuses\/unread_hot_timeline_ad|statuses\/container_positive|statuses\/push_info|comments\/bullet_screens|video\/(?:redpacket|remind_info)|hot\/hours_spotlight|search\/container_discover|profile\/recommend_popuser|!\/live\/media_homelist|!\/chaohua\/discovery\/home_bottom\/switch|!\/huati\/(?:discovery_home_bottom_getdotinfo|mobile_discovery_searchchange)|!\/was\/finder\/searchbarchange|!\/wbox\/\w+\/(?:home_bottom_modal|interest_category)|(?:ad|sdk|preload|floater|pullad)\/) reject-dict
^https?:\/\/api\.weibo\.cn\/!\/sug\/list\/finderchange\b reject-dict
^https?:\/\/(?:card\.weibo\.com\/article\/m\/aj|weibo\.com\/ttarticle\/x\/m\/aj)\/(?:reward|uvead)\b reject-dict

[Header Rewrite]
http-request ^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:profile\/|users\/|search\/|searchall|flowpage|page|cardlist|container\/|video\/|statuses\/video_mixtimeline) header-del if-none-match
http-request ^https?:\/\/[^/]*weibo\.c(?:n|om)\/2\/(?:profile\/|users\/|search\/|searchall|flowpage|page|cardlist|container\/|video\/|statuses\/video_mixtimeline) header-del if-modified-since

[Script]
weibo.splash = type=http-response,pattern=^https?:\/\/(?:(?:sdk|wb)app|bootpreload)\.uve\.weibo\.com\/(?:interface\/sdk\/sdkad\.php|wbapplua\/wbpullad\.lua|preload\/get_ad|v\d+\/ad\/preload),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/weibo/js/weibo_clean.js?v=20261124-2,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{极简界面}}}}"
weibo.clean = type=http-response,pattern=^https?:\/\/(?:[\w-]+\.)?(?:api|m|mapi)\.weibo\.c(?:n|om)\/2\/(?:push\/active|client\/|checkin\/show|ug\/checkin\/stream|statuses\/|groups\/(?:timeline|allgroups\/v2)|video\/|comments\/(?:build_comments|mix_comments)|search\/|searchall|flowpage|flowlist|container\/|page|cardlist|profile\/|users\/show|direct_messages\/user_list|messageflow\/notice|!\/huati\/discovery_home_bottom_channels),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/weibo/js/weibo_clean.js?v=20261124-2,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{极简界面}}}}"

[MITM]
hostname = %APPEND% *.weibo.cn, *.api.weibo.cn, *.uve.weibo.com, *.weibo.com, weibo.com
h2 = true
