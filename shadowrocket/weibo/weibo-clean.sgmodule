#!name=Weibo Clean
#!desc=微博去开屏、时间线推广、评论区软广、商业热搜与「我的」页营销卡片。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/weibo.png
#!arguments=去广告:true, 净化我的页:true
#!arguments-desc=去广告：过滤微博开屏、推荐/关注时间线、评论区软广、发现页商业热搜及活动横幅。\n净化我的页：在「我的」页隐藏我的钱包、借钱、微贷、游戏、直播、免费小说、商城等杂乱营销卡片。

[Rule]
AND,((DOMAIN-SUFFIX,weibo.cn),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,weibo.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,weibocdn.com),(PROTOCOL,QUIC)),REJECT
DOMAIN,ad.weibo.com,REJECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,aln.uve.weibo.com,REJECT
DOMAIN,biz.weibo.com,REJECT
DOMAIN,dp.im.weibo.cn,REJECT
DOMAIN,game.weibo.cn,REJECT
DOMAIN,game.weibo.com,REJECT
DOMAIN,gw5.push.mcp.weibo.cn,REJECT
DOMAIN,gw6.push.mcp.weibo.cn,REJECT
DOMAIN,logmix.sina.cn,REJECT
DOMAIN,pay.sc.weibo.com,REJECT
DOMAIN,promote.biz.weibo.cn,REJECT
DOMAIN,sdkapp.uve.weibo.com,REJECT
DOMAIN,sdkclick.mobile.sina.cn,REJECT
DOMAIN,trends.mobile.sina.cn,REJECT
DOMAIN,u1.img.mobile.sina.cn,REJECT
DOMAIN,wax.weibo.com,REJECT
DOMAIN,zymo.mps.weibo.com,REJECT

[URL Rewrite]
^https?:\/\/sdkapp\.uve\.weibo\.com\/ reject-dict
^https?:\/\/(?:api|m)\.weibo\.cn\/2\/(?:ad|sdk|preload)\/ reject-dict
^https?:\/\/api\.weibo\.cn\/2\/statuses\/unread_hot_timeline_ad\b reject-dict

[Header Rewrite]
http-request ^https?:\/\/(?:api|m|mapi)\.weibo\.c(?:n|om)\/2\/(?:profile\/|search\/|page|cardlist) header-del if-none-match

[Script]
weibo.clean = type=http-response,pattern=^https?:\/\/(?:api|m|mapi)\.weibo\.c(?:n|om)\/(?:wbapplua\/wbpullad\.lua|2\/(?:push\/active|client\/|checkin\/|statuses\/|groups\/timeline|video\/|comments\/build_comments|search\/|page|cardlist|profile\/)),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/weibo/js/weibo_clean.js?v=20261123-2,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{净化我的页}}}}"

[MITM]
hostname = %APPEND% api.weibo.cn, m.weibo.cn, mapi.weibo.com, sdkapp.uve.weibo.com
h2 = true
