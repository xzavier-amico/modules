#!name=NetEase Music Clean
#!desc=网易云音乐去开屏、首页横幅广告、左滑抽屉（商城/云村有票/云推歌）、搜索买榜词与评论区推广。
#!author=xzavier-amico
#!icon=https://raw.githubusercontent.com/xzavier-amico/modules/master/icon/netease.png
#!arguments=去广告:true, 净化侧栏与首页:true
#!arguments-desc=去广告：拦截开屏素材 CDN，并过滤首页横幅、搜索热词与评论区里的商业广告。\n净化侧栏与首页：移除左滑菜单里的商城、云村有票、云推歌、彩铃、游戏、免费听歌，以及首页发现流里的直播与语音房模块。

[Rule]
AND,((DOMAIN-SUFFIX,163.com),(PROTOCOL,QUIC)),REJECT
AND,((DOMAIN-SUFFIX,126.net),(PROTOCOL,QUIC)),REJECT
DOMAIN,admusicpic.music.126.net,REJECT
DOMAIN,g1.163.com,REJECT
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,nex.163.com,REJECT
DOMAIN,yt-adp.nosdn.127.net,REJECT
DOMAIN,yt-adp.ws.126.net,REJECT

[URL Rewrite]
^https?:\/\/interface\d*\.music\.163\.com\/e?api\/(?:ad|sp\/loading\/ad|v1\/ad)\/ reject-dict

[Script]
netease.clean = type=http-response,pattern=^https?:\/\/(?:interface\d*\.music\.163\.com|music\.163\.com)\/e?api\/(?:batch|ad\/|sp\/loading|homepage\/|sidebar|music-main-sidebar|entrance|resource\/exposure|v\d+\/user\/detail|v\d+\/banner\/get|v\d+\/discovery\/|search\/(?:hot|default)|v\d+\/resource\/comments|comment\/),requires-body=1,max-size=8388608,timeout=20,script-path=https://raw.githubusercontent.com/xzavier-amico/modules/master/shadowrocket/netease/js/netease_clean.js?v=20261123-2,argument="{"block_ads":{{{去广告}}},"clean_ui":{{{净化侧栏与首页}}}}"

[MITM]
hostname = %APPEND% interface.music.163.com, interface3.music.163.com, music.163.com
h2 = true
